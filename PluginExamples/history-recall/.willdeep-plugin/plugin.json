{
  "schemaVersion": 1,
  "minimumWillDeepVersion": "1.316.0-rc1",
  "contributes": {
    "destinations": [
      {
        "id": "history-recall",
        "titleKey": "destination.historyRecall",
        "icon": "sf:clock.arrow.circlepath",
        "mainPage": "historyRecall.main",
        "companionSidebar": "historyRecall.sidebar",
        "toolbarCommandIDs": ["historyRecall.refresh"]
      }
    ],
    "sidebars": [{ "id": "historyRecall.sidebar", "mode": "none" }],
    "pages": [
      { "id": "historyRecall.main", "runtime": "localWeb", "entryPath": "ui/index.html" }
    ],
    "commands": [
      {
        "id": "historyRecall.search",
        "titleKey": "command.search",
        "icon": "sf:magnifyingglass",
        "handler": { "type": "mcpTool", "server": "history-recall", "tool": "history.search" }
      },
      {
        "id": "historyRecall.excerpt",
        "titleKey": "command.excerpt",
        "icon": "sf:text.quote",
        "handler": { "type": "mcpTool", "server": "history-recall", "tool": "history.excerpt" }
      },
      {
        "id": "historyRecall.projects",
        "titleKey": "command.projects",
        "icon": "sf:folder",
        "handler": { "type": "mcpTool", "server": "history-recall", "tool": "history.projects" }
      },
      {
        "id": "historyRecall.settings",
        "titleKey": "command.settings",
        "icon": "sf:gearshape",
        "handler": { "type": "mcpTool", "server": "history-recall", "tool": "history.settings" }
      },
      {
        "id": "historyRecall.open",
        "titleKey": "command.open",
        "icon": "sf:clock.arrow.circlepath",
        "handler": { "type": "navigate", "destination": "history-recall" }
      },
      {
        "id": "historyRecall.openSession",
        "titleKey": "command.openSession",
        "icon": "sf:arrow.uturn.backward",
        "handler": { "type": "host", "action": "session.open" }
      },
      {
        "id": "historyRecall.refresh",
        "titleKey": "command.refresh",
        "icon": "sf:arrow.clockwise",
        "handler": { "type": "host", "action": "plugin.refresh" }
      }
    ],
    "menus": {
      "commandPalette": ["historyRecall.open", "historyRecall.refresh"],
      "plugin.page.toolbar": ["historyRecall.refresh"]
    },
    "settings": []
  },
  "permissions": ["conversation.read", "process.execute", "ai.chat", "providers.read"],
  "dependencies": { "mcpServers": ["history-recall"], "skills": [] }
}
