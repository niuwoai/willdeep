    "agent-model-picker.coding-plan-not-purchased-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You can still use Managed Routing. Buy Coding Plan only when a coding package suits your usage." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Puedes seguir usando el enrutamiento gestionado. Compra el Coding Plan solo si un paquete de programación se ajusta a tu uso." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vous pouvez tout de même utiliser le routage géré. N'achetez Coding Plan que si un forfait de codage correspond à votre usage." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "購入しなくてもマネージドルーティングは利用できます。用途に合ったコーディングプランが必要な場合のみ Coding Plan を購入してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不购买也能使用省心托管；只有需要编程套餐包时再购买即可。" } } } },
