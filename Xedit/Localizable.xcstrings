    "editor-terminal.color-scheme-footnote" : {
      "comment" : "Footnote under the color scheme picker explaining Follow App Skin and line spacing limitation",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Follow App Skin” uses the terminal palette matched to your interface skin; ANSI program colors stay standard so output stays readable. Line spacing isn't adjustable with the current terminal engine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Seguir apariencia de la app” usa la paleta de terminal que coincide con la apariencia de tu interfaz; los colores de programas ANSI se mantienen estándar para que la salida siga siendo legible. El motor de terminal actual no permite ajustar el interlineado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Suivre le thème de l'application » utilise la palette du terminal assortie à votre thème d'interface ; les couleurs ANSI des programmes restent standard afin que la sortie reste lisible. L'interligne n'est pas réglable avec le moteur de terminal actuel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アプリスキンに従う」はインターフェースのスキンに合わせたターミナル配色を使用します。ANSI プログラムの色は標準のまま保たれ、出力の読みやすさが確保されます。現在のターミナルエンジンでは行間の調整はできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“跟随应用皮肤”会使用与界面皮肤匹配的终端配色;ANSI 程序色保持标准配色,确保输出清晰可读。当前终端引擎不支持调整行间距。"
          }
        }
      }
    },
