    "editor-terminal.color-scheme-footnote" : {
      "comment" : "Footnote under the color scheme picker explaining Follow App Skin and line spacing limitation",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Follow App Skin” derives the terminal background, foreground, and cursor from your interface skin; ANSI program colors stay standard so output stays readable. Line spacing isn't adjustable with the current terminal engine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“跟随应用皮肤”会根据界面皮肤推导出终端的背景色、前景色和光标颜色;ANSI 程序色保持标准配色,确保输出清晰可读。当前终端引擎不支持调整行间距。"
          }
        }
      }
    },
    "editor-terminal.cursor" : {
