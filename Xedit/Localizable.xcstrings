    "agent-image-editor.generic-edit-hint" : {
      "comment" : "Hint shown when the mask editor has no production anchor context",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generic image editing. Sending to chat exports the mask first when a selection exists and attaches edit_image_with_mask parameters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edición genérica de imagen. Al enviar al chat se exporta primero la máscara si existe una selección y se adjuntan los parámetros de edit_image_with_mask."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Édition d'image générique. L'envoi vers la conversation exporte d'abord le masque si une sélection existe, puis joint les paramètres edit_image_with_mask."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汎用の画像編集です。チャットに送信すると、選択範囲がある場合は先にマスクをエクスポートし、edit_image_with_mask のパラメータを添付します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通用图片编辑；发送到聊天会在已有选区时先导出蒙版，并附带 edit_image_with_mask 参数。"
          }
        }
      }
    },
    "agent-image-editor.invert-help" : {
      "comment" : "Tooltip for the invert-mask toggle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the white edit region becomes everything outside the selection — good for keeping the subject and repainting the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activarlo, la región blanca de edición pasa a ser todo lo que está fuera de la selección — útil para conservar el sujeto y repintar el fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activé, la zone d'édition blanche devient tout ce qui se trouve en dehors de la sélection — idéal pour conserver le sujet et repeindre l'arrière-plan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、編集対象の白い領域が選択範囲の外側全体になります —— 被写体を残したまま背景を描き直す場合に適しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后白色编辑区域会变成选区外部，适合保留主体、重绘背景。"
          }
        }
      }
    },
