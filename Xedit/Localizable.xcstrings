    "dispatch.goal-setup-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Describe the outcome and acceptance criteria. WillDeep will turn them into an executable plan here." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Describe el resultado y los criterios de aceptación. WillDeep los convertirá aquí en un plan ejecutable." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Décrivez le résultat attendu et les critères d'acceptation. WillDeep les transformera ici en un plan exécutable." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "目標の成果と受け入れ基準を記述してください。WillDeep がここで実行可能な計画に変換します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "描述目标结果和验收标准，WillDeep 会直接在调度台把它们整理成可执行计划。" } } } },
