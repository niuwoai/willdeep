    "sidebar.archive-with-tasks.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session has %@ active scheduled task(s). Archiving stops and removes them — they won't run anymore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión tiene %@ tarea(s) programada(s) activa(s). Archivarla las detendrá y eliminará; ya no se ejecutarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session a %@ tâche(s) planifiée(s) active(s). L'archivage les arrête et les supprime — elles ne s'exécuteront plus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションには %@ 件のアクティブな定時タスクがあります。アーカイブすると停止・削除され、今後実行されなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此会话有 %@ 个活跃定时任务。归档会停止并移除它们——它们将不再运行。"
          }
        }
      }
    },
