          }
        }
      }
    },
    "composer.insert-secret.description" : {
      "comment" : "Description shown in the protected secret insertion sheet",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add up to three secrets. Each secret is saved locally in Keychain; the model only sees placeholders, and WillDeep resolves them when a local tool runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade hasta tres secretos. Cada secreto se guarda localmente en Keychain; el modelo solo ve marcadores de posición, y WillDeep los resuelve cuando se ejecuta una herramienta local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez jusqu'à trois secrets. Chaque secret est enregistré localement dans le Trousseau ; le modèle ne voit que des espaces réservés, que WillDeep résout lors de l'exécution d'un outil local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機密情報は最大3件まで追加できます。各機密情報はローカルのキーチェーンに保存され、モデルにはプレースホルダーのみが渡されます。ローカルツールの実行時にWillDeepが実際の値に解決します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次最多添加三个机密。每个机密只保存在本机钥匙串里；模型只会看到占位符，WillDeep 会在本地工具实际执行时再解析。"
          }
        }
      }
    },
