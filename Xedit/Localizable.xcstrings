    "agent-delegation.profile-judge-purpose" : {
      "comment" : "User-facing description of the judge trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns one bounded verdict about material you supply: a routing choice, a quality check, a classification. No tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve un veredicto acotado sobre el material que le des: elección de ruta, control de calidad, clasificación. Sin herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend un verdict borné sur le matériel fourni : choix de routage, contrôle qualité, classification. Sans outils."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渡された材料について、ルーティング選択・品質チェック・分類などの限定的な判定を 1 つ返します。ツールなし。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "针对你给的材料返回一个有界裁决：路由选择、质量检查或分类。无工具。"
          }
        }
      }
    },
    "agent-delegation.profile-ops-runner-name" : {
      "comment" : "Display name of the ops-runner subagent trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
