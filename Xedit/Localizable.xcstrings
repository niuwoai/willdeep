    "agent-profiles.capability-built-in-note" : {
      "comment" : "Explains why built-in tool sets are not editable",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A built-in trade's tool set and budgets are code, not settings: the narrow tool set is what makes it cheap and accurate. Create a custom profile to choose your own tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El conjunto de herramientas y presupuestos de un oficio integrado son código, no configuración: es precisamente ese conjunto reducido de herramientas lo que lo hace económico y preciso. Crea un perfil personalizado para elegir tus propias herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu d'outils et le budget d'un métier intégré relèvent du code, pas des réglages : c'est ce jeu d'outils restreint qui le rend économique et précis. Créez un profil personnalisé pour choisir vos propres outils."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みの職種が使うツールセットと予算はコードで定義されており、設定ではありません。ツールセットを絞ることで低コストかつ高精度になっています。独自のツールを選びたい場合はカスタムプロファイルを作成してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置工种的工具集与预算属于代码而非配置：正是这份窄工具集让它又快又准。想自定义工具集请新建档案。"
          }
        }
      }
    },
    "agent-profiles.capability-external-note" : {
