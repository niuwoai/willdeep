    "dispatch.plan-update-failed-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check that the title is present, the task is not running, and the selected prerequisites do not create a cycle." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprueba que el título esté presente, que la tarea no esté en ejecución y que los nodos previos seleccionados no formen un ciclo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifiez que le titre est renseigné, que la tâche n'est pas en cours d'exécution et que les prérequis sélectionnés ne créent pas de cycle." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "タイトルが入力されているか、タスクが実行中でないか、選択した前提ノードが循環依存を作らないかを確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请确认标题不为空、任务未在运行，并且所选前置节点不会形成循环依赖。" } } } },
