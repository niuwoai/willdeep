    "The agent can read files, search, list directories, run commands (with approval), and check Git status." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 可以读取文件、搜索、列出目录、运行命令（需批准）以及查看 Git 状态。"
          }
        }
      }
    },
    "The model also auto-unloads after 5 minutes of foreground idle, 10 minutes of background, or when the app's resident memory exceeds 4 GB." : {
      "extractionState" : "stale",
      "localizations" : {
