    "automation.template.weekly-review.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review the current project for the week: summarize major changes, completed work, remaining risks, and suggested next-week focus. Keep it concise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el proyecto actual de la semana: resume los cambios principales, el trabajo completado, los riesgos pendientes y el enfoque sugerido para la próxima semana. Sé conciso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en revue le projet actuel pour la semaine : résumez les changements majeurs, le travail effectué, les risques restants et les priorités suggérées pour la semaine prochaine. Restez concis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週の現在のプロジェクトをレビューしてください：主要な変更、完了した作業、残っているリスク、来週注力すべき点をまとめてください。簡潔にお願いします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请回顾当前项目本周情况：总结主要变化、已完成工作、遗留风险和下周建议关注点。保持简洁。"
          }
        }
      }
    },
