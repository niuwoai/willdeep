    "roundtable.setup.preparation-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shape the question before the discussion" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Define la pregunta antes de la discusión" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Clarifiez la question avant la discussion" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "議論の前に問いを整理する" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开会前，先把问题想清楚" } } } },
    "roundtable.setup.preparation-subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep will clarify the decision, propose a framework, and suggest a panel. You stay in control before anyone speaks." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep aclarará la decisión, propondrá un marco y sugerirá un panel. Tú mantienes el control antes de que nadie hable." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep clarifie la décision, propose un cadre et suggère un panel. Vous gardez le contrôle avant que quiconque ne prenne la parole." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep が決定事項を整理し、フレームワークとパネルを提案します。発言が始まる前は、あなたが主導権を持ちます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep 会先梳理决策问题、讨论框架与专家建议；正式发言前，由你拍板。" } } } },
    "roundtable.setup.original-topic" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your original question" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu pregunta original" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Votre question initiale" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初の質問" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你最初提出的议题" } } } },
    "roundtable.setup.refined-topic" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Question to decide" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pregunta a decidir" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Question à trancher" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "決定すべき問い" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这次真正要决定的问题" } } } },
    "roundtable.setup.framework-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Discussion framework" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Marco de discusión" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cadre de discussion" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "議論のフレームワーク" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "讨论框架" } } } },
    "roundtable.setup.clarification-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Worth clarifying" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Vale la pena aclarar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "À clarifier" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "確認しておきたい点" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "值得继续澄清" } } } },
    "roundtable.setup.recommendation-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Suggested panel" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Panel sugerido" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Panel suggéré" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "推奨パネル" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "建议邀请的专家" } } } },
    "roundtable.setup.recommendation-hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "These are suggestions, not a fixed lineup. You can add or remove experts next." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Estas son sugerencias, no una alineación fija. A continuación puedes añadir o quitar expertos." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce ne sont que des suggestions, pas une composition figée. Vous pourrez ajouter ou retirer des experts ensuite." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらは提案であり、固定の顔ぶれではありません。次のステップで専門家を追加・削除できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这只是建议阵容，下一步仍可自由增删专家。" } } } },
    "roundtable.setup.refine-placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add context, correct an assumption, or change the discussion focus…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade contexto, corrige un supuesto o cambia el enfoque de la discusión…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajoutez du contexte, corrigez une hypothèse ou modifiez l'angle de discussion…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "背景を補足する、前提を修正する、議論の焦点を変更する…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "补充背景、纠正假设，或调整你希望讨论的重点……" } } } },
