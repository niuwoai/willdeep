    "settings.remote-runtimes.terminal-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Agent Terminal uses an interactive SSH PTY. User typing goes straight to the terminal; AI command input still requires approval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Agent Terminal usa un PTY SSH interactivo. Lo que escribes va directo al terminal; los comandos de la IA siguen requiriendo aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Agent Terminal utilise un PTY SSH interactif. La saisie manuelle de l'utilisateur va directement au terminal ; les commandes envoyées par l'IA nécessitent toujours une approbation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Terminal は対話型の SSH PTY を使用します。ユーザーの入力はそのままターミナルに送られますが、AI によるコマンド入力は引き続き承認が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent Terminal 使用交互式 SSH PTY。用户手动输入会直接进入终端；AI 发送命令仍需要审批。"
          }
        }
      }
    },
