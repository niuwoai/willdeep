        "en" : { "stringUnit" : { "state" : "translated", "value" : "Relay mode shares one room token instead of per-device tokens. To de-authorize a phone, rotate the relay room — every paired device must re-scan." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中继模式共用一个房间令牌，没有按设备令牌。要注销某台手机，请轮换中继房间——所有已配对设备都需重新扫码。" } }
