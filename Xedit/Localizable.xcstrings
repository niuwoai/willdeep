    "plan-continuation.missing-progress-paused" : {
      "comment" : "error shown when plan status reconciliation still produces no structured step updates",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan status sync paused: no valid step statuses arrived after reconciliation. This does not mean execution failed. Review the plan and mark it complete, or add guidance to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización del estado del plan pausada: no llegó ningún estado de paso válido tras la reconciliación. Esto no significa que la ejecución haya fallado. Revisa el plan y márcalo como completo, o añade instrucciones para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisation de l'état du plan en pause : aucun état d'étape valide n'est arrivé après la réconciliation. Cela ne signifie pas que l'exécution a échoué. Vérifiez le plan et marquez-le comme terminé, ou ajoutez des indications pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画のステータス同期を一時停止しました：整合処理後も有効なステップステータスが届いていません。これは実行失敗を意味するものではありません。計画を確認して完了にするか、指示を追加して続行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划状态同步已暂停：状态校准后仍未收到有效的步骤状态。这不代表任务执行失败；请检查计划并标记完成，或补充说明后继续。"
          }
        }
      }
    },
    "plan-continuation.safety-limit-paused" : {
      "comment" : "error shown when plan auto-continuation reaches its bounded safety limit",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan auto-continuation reached its 8-round safety limit. Review the current deliverables and step statuses before continuing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La continuación automática del plan alcanzó su límite de seguridad de 8 rondas. Revisa los entregables actuales y los estados de los pasos antes de continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La poursuite automatique du plan a atteint sa limite de sécurité de 8 tours. Vérifiez les livrables actuels et l'état des étapes avant de continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画の自動継続が8ラウンドの安全上限に達しました。続行する前に、現在の成果物とステップステータスを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计划自动续跑已达到 8 轮安全上限。请检查当前产物与步骤状态后继续。"
          }
        }
      }
    },
