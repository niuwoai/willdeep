    "agent-delegation.profile-log-inspector-purpose" : {
      "comment" : "User-facing description of the log inspector trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clusters and explains errors, stack traces and log excerpts. Read-only, no shell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa y explica errores, trazas y extractos de registros. Solo lectura, sin shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupe et explique erreurs, traces et extraits de logs. Lecture seule, sans shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エラー・スタックトレース・ログ抜粋をクラスタリングして説明します。読み取り専用、シェルなし。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对报错、堆栈与日志片段聚类并解释。只读，无 shell。"
          }
        }
      }
    },
