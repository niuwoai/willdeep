    "dispatch.planner-picker-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Planner breaks down the goal and creates the task graph. It uses one primary model and one fallback model." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El Planner descompone el objetivo y crea el grafo de tareas. Usa un modelo principal y un modelo de reserva." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Planner décompose l'objectif et crée le graphe de tâches. Il utilise un modèle principal et un modèle de repli." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プランナーは目標を分解し、タスクグラフを作成します。主要モデル 1 つとフォールバックモデル 1 つを使用します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Planner 负责拆解目标和生成任务图，只使用一个主模型和一个备选模型。" } } } },
