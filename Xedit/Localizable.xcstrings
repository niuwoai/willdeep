    "settings.memory.merge-parameters-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current local maintenance pass handles retention and archiving. LLM-assisted duplicate merging can be wired into this section once the Agent memory retrieval pipeline starts consuming embeddings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proceso local de mantenimiento actual se encarga de la retención y el archivado. La combinación de duplicados asistida por LLM podrá integrarse en esta sección cuando el flujo de recuperación de memoria del Agent empiece a usar embeddings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passe de maintenance locale actuelle gère la rétention et l'archivage. La fusion des doublons assistée par LLM pourra être intégrée à cette section une fois que le pipeline de récupération de mémoire de l'Agent commencera à exploiter les embeddings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のローカルメンテナンスは保持とアーカイブのみを処理します。Agent の記憶検索パイプラインが embeddings を利用し始めたら、LLM 支援による重複統合をこのセクションに組み込めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前本地维护只做保留与归档。一旦 Agent 记忆检索链路开始消费 embeddings，可在此接入 LLM 辅助的重复合并。"
          }
        }
      }
    },
