    "agent-image-editor.replicate.help-erase" : {
      "comment" : "Footnote for the Replicate provider in erase mode",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate prefers the version entered here; when empty, the image-erase version from Settings → Integrations → Replicate is used. Erase can run without a prompt — a basic background-repair prompt is added automatically on submit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate prefiere la versión introducida aquí; si está vacía, se usa la versión de borrado de imagen de Ajustes → Integraciones → Replicate. El borrado puede ejecutarse sin prompt — se añade automáticamente un prompt básico de reparación de fondo al enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate utilise en priorité la version saisie ici ; si elle est vide, la version d'effacement d'image de Réglages → Intégrations → Replicate est utilisée. L'effacement peut s'exécuter sans consigne — une consigne basique de réparation d'arrière-plan est ajoutée automatiquement à l'envoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate はここに入力された version を優先します。空欄の場合は「設定 → 連携 → Replicate」の画像消去用 version が使用されます。消去はプロンプトなしでも実行でき、送信時に基本的な背景修復プロンプトが自動的に追加されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate 会优先使用这里填写的 version；留空时使用 Settings → Integrations → Replicate 的图片擦除 version。擦除可不填提示词，提交时会自动补一个基础背景修复提示。"
          }
        }
      }
    },
    "agent-image-editor.replicate.help-inpaint" : {
      "comment" : "Footnote for the Replicate provider in inpaint mode",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate prefers the version entered here; when empty, the mask-inpaint version from Settings → Integrations → Replicate is used. The model must accept image, mask, and prompt inputs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate prefiere la versión introducida aquí; si está vacía, se usa la versión de repintado de máscara de Ajustes → Integraciones → Replicate. El modelo debe aceptar entradas de image, mask y prompt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate utilise en priorité la version saisie ici ; si elle est vide, la version de retouche par masque de Réglages → Intégrations → Replicate est utilisée. Le modèle doit accepter les entrées image, mask et prompt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate はここに入力された version を優先します。空欄の場合は「設定 → 連携 → Replicate」のマスクインペイント用 version が使用されます。モデルは image、mask、prompt の入力に対応している必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate 会优先使用这里填写的 version；留空时使用 Settings → Integrations → Replicate 的蒙版重绘 version。该模型需支持 image、mask、prompt 输入。"
          }
        }
      }
    },
    "agent-image-editor.replicate.need-erase-version" : {
      "comment" : "Configuration issue when no erase version is available",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
