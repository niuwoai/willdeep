    "agent-delegation.profile-build-fixer-purpose" : {
      "comment" : "User-facing description of the build fixer trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes compiler, type-check and lint failures inside the files it was given, verified by the build command."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige fallos de compilación, tipos y lint en los archivos indicados, verificado por el comando de build."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige les erreurs de compilation, de typage et de lint dans les fichiers fournis, vérifié par la commande de build."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渡されたファイル内のコンパイル・型・Lint エラーを修正し、ビルドコマンドで検証します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在给定文件范围内修复编译、类型与 lint 错误，由构建命令验证。"
          }
        }
      }
    },
    "agent-delegation.profile-git-detective-name" : {
