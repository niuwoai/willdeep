    "agent-profiles.pane-description" : {
      "comment" : "Explains the unified profile list",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One list for both the trades `spawn_agent` can pick and the executors a dispatch node can run on. A profile carries its own soul: what it is for, its own prompt section, and the skills it preloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola lista tanto para los oficios que spawn_agent puede elegir como para los ejecutores en los que puede correr un nodo de despacho. Un perfil tiene su propia identidad: para qué sirve, su propia sección de prompt y las habilidades que precarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule liste pour les métiers que spawn_agent peut choisir et les exécuteurs sur lesquels un nœud de répartition peut s'exécuter. Un profil porte sa propre âme : à quoi il sert, sa section de prompt propre, et les compétences qu'il précharge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spawn_agent が選べる職種と、ディスパッチノードが実行できる実行者は同じ一覧です。各プロファイルは用途・専用プロンプト・自動読み込みするスキルという固有の「魂」を持ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子代理工种与调度台执行器现在是同一份列表。每个档案有自己的「灵魂」：负责什么、专属提示词、以及自动加载的技能包。"
          }
        }
      }
    },
