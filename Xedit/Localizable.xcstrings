    "settings.connectors.cloud-relay-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoming @mentions need a public callback. Cloud Relay can receive platform events and forward them to this Mac when it is online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las menciones @ entrantes necesitan una devolución de llamada pública. Cloud Relay puede recibir eventos de la plataforma y reenviarlos a este Mac cuando esté en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mentions @ entrantes nécessitent un rappel public. Cloud Relay peut recevoir les événements de la plateforme et les transmettre à ce Mac lorsqu'il est en ligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受信した@メンションにはパブリックなコールバックが必要です。Cloud Relayはプラットフォームのイベントを受信し、このMacがオンラインのときに転送できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收 @ 提及需要公网回调。Cloud Relay 可先接平台事件，再在这台 Mac 在线时转发。"
          }
        }
      }
    },
