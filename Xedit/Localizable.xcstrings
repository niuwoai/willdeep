    "secret-manager.pane-description" : {
      "comment" : "Explains where secret values live",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Values stay in the Keychain. The model only ever sees the ${secret:…} placeholder; the real value is substituted locally, at the moment a tool runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores permanecen en el llavero. El modelo solo ve el marcador de posición ${secret:…}; el valor real se sustituye localmente en el momento en que se ejecuta una herramienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs restent dans le trousseau. Le modèle ne voit jamais que l'espace réservé ${secret:…} ; la valeur réelle est substituée localement, au moment où un outil s'exécute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値はKeychainに保存されます。モデルが目にするのは ${secret:…} プレースホルダーのみで、実際の値はツール実行の瞬間にローカルで置き換えられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥值只存在钥匙串里。模型全程只看到 ${secret:…} 占位符，真实值在本地工具执行的那一刻才代入。"
          }
        }
      }
    },
