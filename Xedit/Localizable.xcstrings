    "settings.mobile-gateway.transport-mode-relay-caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Default. Connects through the public relay, so your phone works from anywhere with no local gateway to run. Session content is routed through the relay server (transport-encrypted, not yet end-to-end)." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认。通过公共中继连接，手机在任何网络下都能用，无需运行本地网关。会话内容经中继服务器转发（传输层加密，尚未端到端加密）。" } }
      }
    },
    "settings.mobile-gateway.transport-mode-lan-caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Fallback. Runs a local gateway process for same-network pairing with per-device tokens — useful offline or on isolated networks." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "备选。启动本地网关进程，在同一网络内用按设备令牌配对——适合离线或隔离网络。" } }
      }
    },
