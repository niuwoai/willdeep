    "agent-delegation.profile-deep-name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deep" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Profundo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Approfondi" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "精査" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "深查" } } } },
    "agent-delegation.profile-deep-purpose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Complex investigation: reasoning across many files, read-only shell commands, and git status." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Investigación compleja: razonamiento a través de muchos archivos, comandos de shell de solo lectura y estado de git." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Investigation complexe : raisonnement sur de nombreux fichiers, commandes shell en lecture seule et état Git." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "複雑な調査: 多数のファイルを横断した推論、読み取り専用の shell コマンド、git ステータスの確認。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复杂调查：跨多文件推理、只读 shell 命令和 git 状态。" } } } },
    "agent-delegation.profile-editor-name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Editor" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Editor" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Éditeur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "編集" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑" } } } },
    "agent-delegation.profile-editor-purpose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Edits one declared file inside the parent workspace policy; cannot touch any other path." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Edita un archivo declarado dentro de la política del espacio de trabajo principal; no puede tocar ninguna otra ruta." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modifie un fichier déclaré dans la politique de l'espace de travail parent ; ne peut toucher aucun autre chemin." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "親ワークスペースのポリシー内で宣言された1つのファイルだけを編集し、他のパスには触れません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在父会话工作区策略内编辑一个已声明文件，不能触碰其他路径。" } } } },
    "agent-delegation.profile-implementer-name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Implementer" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Implementador" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Implémenteur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実装" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实现" } } } },
    "agent-delegation.profile-implementer-purpose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Implements a bounded multi-file feature or refactor across at most 16 declared existing or new paths on a deployable 256K model." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Implementa una función o refactorización acotada en hasta 16 rutas declaradas, existentes o nuevas, con un modelo desplegable de 256K." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Implémente une fonctionnalité ou refactorisation bornée sur au plus 16 chemins déclarés, existants ou nouveaux, avec un modèle déployable de 256K." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "デプロイ可能な256Kモデルで、宣言済みの既存または新規パス最大16件に限定した複数ファイルの機能実装やリファクタリングを行います。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用可部署的 256K 模型，在最多 16 个已声明的现有或新路径内完成有界多文件功能或重构。" } } } },
    "agent-delegation.profile-inherits-parent" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Same as this chat" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Igual que esta conversación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Identique à cette conversation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このチャットと同じ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "与本会话相同" } } } },
    "agent-delegation.profile-fetched-models" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Fetched %1$d models from %2$@." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se obtuvieron %1$d modelos de %2$@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%1$d modèles récupérés depuis %2$@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%2$@ から %1$d 個のモデルを取得しました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已从 %2$@ 获取 %1$d 个模型。" } } } },
    "agent-delegation.profile-model-label" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Modelo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modèle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデル" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型" } } } },
    "agent-delegation.profile-model-placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Type a model ID" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escribe un ID de modelo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Saisissez un ID de modèle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデル ID を入力" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "手动输入模型 ID" } } } },
    "agent-delegation.profile-no-models-returned" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No models returned by /v1/models." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "/v1/models no devolvió ningún modelo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun modèle renvoyé par /v1/models." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "/v1/models からモデルが返されませんでした。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "/v1/models 未返回模型。" } } } },
    "agent-delegation.profile-no-providers" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No providers configured" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay proveedores configurados" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun fournisseur configuré" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロバイダが設定されていません" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未配置 Provider" } } } },
    "agent-delegation.profile-pick-fetched-model" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a configured or fetched model" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige un modelo configurado u obtenido" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez un modèle configuré ou récupéré" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定済みまたは取得済みのモデルを選択" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择已配置或已拉取的模型" } } } },
    "agent-delegation.profile-provider-label" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Provider" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Proveedor" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fournisseur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロバイダ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Provider" } } } },
    "agent-delegation.profile-reader-name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reader" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Lector" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lecteur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読解" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "阅读" } } } },
    "agent-delegation.profile-reader-purpose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read and summarize: digest long files, docs, or public web pages and answer questions about their content. No shell." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Leer y resumir: procesa archivos largos, documentos o páginas web públicas y responde preguntas sobre su contenido. Sin shell." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lecture et synthèse : digère des fichiers longs, des documents ou des pages web publiques et répond à des questions sur leur contenu. Sans shell." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読解と要約: 長いファイルやドキュメント、公開ウェブページを読み込んで内容に関する質問に答えます。shell は使いません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "阅读归纳：消化长文件、文档或公开网页并回答内容问题。不带 shell。" } } } },
    "agent-delegation.profile-scout-name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scout" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Explorador" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Éclaireur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "偵察" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "侦察" } } } },
    "agent-delegation.profile-scout-purpose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Locate things: find files, symbols, call sites, or answer \"where is X / does X exist\". Fastest and cheapest; no shell." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Localiza cosas: encuentra archivos, símbolos, puntos de llamada, o responde \"dónde está X / existe X\". El más rápido y económico; sin shell." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Localise des éléments : trouve des fichiers, des symboles, des sites d'appel, ou répond à « où est X / X existe-t-il ». Le plus rapide et le moins coûteux ; sans shell." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "対象の特定: ファイル、シンボル、呼び出し箇所を探し、「X はどこにあるか / X は存在するか」に答えます。最速かつ最も低コストで、shell は使いません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "定位类任务：找文件、符号、调用点，或回答“X 在哪 / 有没有 X”。最快最省；不带 shell。" } } } },
    "agent-delegation.profile-tools-label" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tools" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Herramientas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Outils" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ツール" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "工具" } } } },
    "agent-delegation.profile-unavailable-fallback" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unavailable — falls back to this chat's model" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No disponible — recurre al modelo de esta conversación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Indisponible — reprend le modèle de cette conversation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用不可 —— このチャットのモデルにフォールバックします" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不可用——将回退到本会话的模型" } } } },
    "agent-delegation.profiles-section-footer" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Each trade runs with its own provider and model. Tool sets are fixed; provider and model bindings save automatically." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cada oficio se ejecuta con su propio proveedor y modelo. Los conjuntos de herramientas son fijos; los enlaces de proveedor y modelo se guardan automáticamente." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chaque métier s'exécute avec son propre fournisseur et modèle. Les ensembles d'outils sont fixes ; les associations de fournisseur et de modèle s'enregistrent automatiquement." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "各ワークタイプは独自のプロバイダとモデルで動作します。ツールセットは固定で、プロバイダとモデルの割り当ては自動的に保存されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每个工种可使用独立的 Provider 与模型。工具集固定，Provider 和模型绑定会自动保存。" } } } },
    "agent-delegation.profiles-section-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Subagent trades" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Oficios de subagentes" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Métiers des sous-agents" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サブエージェントのワークタイプ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "子智能体工种" } } } },
    "agent-workspace-goal-awareness.dispatch-running" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dispatch project “%@” is already running in this workspace · %lld/%lld" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El proyecto de despacho «%@» ya se está ejecutando en este espacio de trabajo · %lld/%lld" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le projet de répartition « %@ » est déjà en cours d'exécution dans cet espace de travail · %lld/%lld" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このワークスペースではディスパッチプロジェクト「%@」が既に実行中です · %lld/%lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此工作区的调度项目“%@”正在运行 · %lld/%lld" } } } },
