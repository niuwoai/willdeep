    "agent-delegation.profile-test-fixer-purpose" : {
      "comment" : "User-facing description of the test fixer trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes a failing test to green inside the files it was given. The verifier command decides success, not the model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja en verde una prueba fallida dentro de los archivos indicados. El comando verificador decide el éxito, no el modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait repasser un test au vert dans les fichiers fournis. C'est la commande de vérification qui décide, pas le modèle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渡されたファイル内で失敗テストをグリーンにします。成功を決めるのは検証コマンドであり、モデルではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在给定文件范围内把失败测试修到全绿。成功与否由验证命令判定，不是模型说了算。"
          }
        }
      }
    },
    "agent-delegation.profile-tester-purpose" : {
      "comment" : "User-facing description of the tester trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs tests and gates, reports evidence, never edits code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta pruebas y verificaciones, informa evidencias, nunca edita código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute les tests et les contrôles de qualité, fournit des preuves, ne modifie jamais le code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストとゲートを実行して証拠を報告し、コードは一切編集しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跑测试与门禁、产出证据，从不改代码。"
          }
        }
      }
    },
    "agent-delegation.profile-reviewer-purpose" : {
      "comment" : "User-facing description of the reviewer trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independent read-only review of a change's scope, version consistency and git hygiene."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisión independiente de solo lectura del alcance de un cambio, la coherencia de versiones y la limpieza de git."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revue indépendante en lecture seule du périmètre d'une modification, de la cohérence des versions et de l'hygiène Git."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更の範囲、バージョンの整合性、git の状態を独立して読み取り専用でレビューします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读地独立复核改动范围、版本一致性与 git 完整性。"
          }
        }
      }
    },
