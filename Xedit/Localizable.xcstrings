    "settings.agent-behavior.appearance-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base size (pt) for Agent chat message body and rendered Markdown blocks (paragraphs, lists, quotes, fenced code, tables). Tool-call summaries, footers, message headers, and composer chrome keep their fixed sizes — this knob is about reading the conversation, not resizing the whole UI. Default is 15 pt; range %1$@ – %2$@ pt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 聊天正文和 Markdown 块（段落、列表、引用、代码块、表格）的基础字号（pt）。工具卡片摘要、底栏、消息头、输入框工具栏会保持固定字号 — 这个旋钮只管「读对话」，不会缩放整个 UI。默认 15 pt；范围 %1$@ – %2$@ pt。"
          }
        }
      }
    },
    "settings.agent-behavior.anthropic-max-output-tokens" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Anthropic reply limit" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Anthropic 回复上限" } } } },
    "settings.agent-behavior.anthropic-max-output-tokens-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Maximum tokens a single Anthropic reply may produce (max_tokens). Default 32K keeps long documents and large refactor replies from truncating; legacy Claude 3.x models are automatically clamped to their lower API caps." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "单次 Anthropic 回复允许生成的最大 token 数（max_tokens）。默认 32K，长文档与大型重构回复不再被截断；旧的 Claude 3.x 系列会自动收紧到其 API 上限。" } } } },
    "settings.agent-behavior.concurrency-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap on simultaneous Agent turns per provider. Each provider has its own quota — running 3 DashScope sessions doesn't block OpenAI sessions. When the cap is hit, new dispatches queue (FIFO) and drain as turns finish. Raising the cap immediately promotes queued work; lowering it just stops promoting new ones (running turns are never aborted). Default 3 is conservative — bump up if your provider's rate limit comfortably allows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个服务商可以同时跑的 Agent 回合数上限。每个服务商有独立配额——同时跑 3 个 DashScope 会话不会挡 OpenAI 会话。达到上限后新请求按先来后到入队，等回合结束再依次释放。调高立刻放行排队中的任务；调低只是不再放新任务（运行中的回合永远不会被中断）。默认 3 比较保守——服务商限流够宽就可以调大。"
          }
        }
      }
    },
    "settings.agent-behavior.save-note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystrokes stay local until you press Save (⌘↩). API keys are stored separately in Keychain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入仅在按下保存（⌘↩）后才会落盘。API Key 单独保存在 Keychain。"
          }
        }
      }
    },
    "settings.agent-behavior.title-model" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title Model"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标题模型"
          }
        }
      }
    },
    "settings.agent-behavior.title-model-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short one-shot completion summarizes each new chat into a ≤12-char title after the first assistant reply. Set a cheap/fast model here (e.g. `deepseek-chat`, `gpt-4o-mini`, `qwen-turbo`) to avoid burning Pro tokens on titling. Empty → falls back to the active provider's Flash model."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首条助手回复后用一次性短补全把对话压成 ≤12 字标题。在这里指定一个便宜/快的模型（如 `deepseek-chat`、`gpt-4o-mini`、`qwen-turbo`），避免起标题烧 Pro token。留空 → 回退到当前服务商的 Flash 模型。"
          }
        }
      }
    },
    "settings.agent-behavior.title-model-placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(leave empty → use Flash model)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（留空 → 使用 Flash 模型）"
          }
        }
      }
    },
    "settings.agent-behavior.tool-approval-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only shell commands in the built-in allowlist (cat, head, tail, ls, find without -delete/-exec, git diff/log/status/show, rg, grep, wc, file, stat, which, pwd, echo, …) run without asking. Commands outside the allowlist are passed to a one-shot LLM judge running on the active provider's **Flash** model (cheap & fast — never Pro), and only YES verdicts auto-run. Destructive patterns (rm, sudo, git push --force, git reset --hard, …) still require typing \"confirm\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置只读白名单里的 shell 命令（cat、head、tail、ls、不带 -delete/-exec 的 find、git diff/log/status/show、rg、grep、wc、file、stat、which、pwd、echo 等）直接执行不会询问。名单之外的命令交给一次性 LLM 判官，跑在当前服务商的 **Flash** 模型（便宜快速 — 绝不走 Pro），只有 YES 才自动执行。破坏性命令（rm、sudo、git push --force、git reset --hard 等）仍需手动输入 \"confirm\"。"
          }
        }
      }
    },
