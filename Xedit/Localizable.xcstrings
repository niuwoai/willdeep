    "composer.design-to-code.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Implement the attached UI in this workspace, then verify it with Browser or Computer Use" } },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implementa la interfaz adjunta en este espacio de trabajo y verifícala con el navegador o Computer Use"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implémenter l'interface jointe dans cet espace de travail, puis la vérifier avec le navigateur ou Computer Use"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付のUIをこのワークスペースに実装し、ブラウザまたはComputer Useで検証します"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把附图实现到当前工作区，并通过浏览器或 Computer Use 实际验收" } }
      }
    },
    "composer.design-to-code.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Implement the attached UI completely in the current workspace using the existing project stack. Write the production code directly, build and run it, then use Browser or Computer Use to capture the real result and compare it with the source. Make at most three focused correction passes; then report any remaining material differences instead of looping." } },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implementa por completo la interfaz adjunta en el espacio de trabajo actual usando el stack existente del proyecto. Escribe directamente el código de producción, compílalo y ejecútalo, y luego usa el navegador o Computer Use para capturar el resultado real y compararlo con el original. Realiza como máximo tres rondas de corrección centradas; después informa las diferencias importantes que queden en vez de seguir repitiendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implémentez entièrement l'interface jointe dans l'espace de travail actuel en utilisant la pile technique existante du projet. Écrivez directement le code de production, compilez-le et exécutez-le, puis utilisez le navigateur ou Computer Use pour capturer le résultat réel et le comparer à la source. Effectuez au maximum trois passes de correction ciblées, puis signalez les différences importantes restantes au lieu de boucler indéfiniment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のプロジェクトスタックを使用して、添付のUIを現在のワークスペースに完全に実装してください。本番用コードを直接記述し、ビルドして実行したうえで、ブラウザまたはComputer Useを使って実際の結果をキャプチャし、元の画像と比較してください。的を絞った修正は最大3回まで行い、それでも残る明確な差異はループさせずに報告してください。"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请使用当前项目已有技术栈，把附图中的界面完整实现到当前工作区。直接写入生产代码、构建并运行，然后使用浏览器或 Computer Use 捕获真实结果并与原图比较；最多进行三轮有针对性的修正，之后应报告仍存在的明显差异，不要无限循环。" } }
      }
    },
