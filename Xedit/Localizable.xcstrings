    "agent-side-panel.diff-source-file-too-large" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This file is %@ bytes, above the side-panel file limit of %@ bytes, so its diff is not generated here. Open it in an editor or use an external Git tool to review it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo tiene %@ bytes, por encima del límite de %@ bytes del panel lateral, por lo que su diff no se genera aquí. Ábrelo en un editor o usa una herramienta Git externa para revisarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier fait %@ octets, ce qui dépasse la limite de %@ octets du panneau latéral, son diff n'est donc pas généré ici. Ouvrez-le dans un éditeur ou utilisez un outil Git externe pour le consulter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは %@ バイトで、サイドパネルのファイル上限 %@ バイトを超えているため diff を生成しません。エディタで開くか、外部の Git ツールで確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件大小为 %@ 字节，超过侧边栏 %@ 字节的文件上限，因此不会在这里生成 Diff。请在编辑器或外部 Git 工具中查看。"
          }
        }
      }
    },
    "agent-side-panel.diff-too-large" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Diff is %@ UTF-8 bytes / %@ lines, above the side-panel budget of %@ bytes / %@ lines, so it is not displayed here. Open the file in an editor or use git diff --no-ext-diff HEAD -- <path> to review it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El diff tiene %@ bytes UTF-8 / %@ líneas, por encima del presupuesto del panel lateral de %@ bytes / %@ líneas, por lo que no se muestra aquí. Abre el archivo en un editor o ejecuta git diff --no-ext-diff HEAD -- <path> para revisarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le diff fait %@ octets UTF-8 / %@ lignes, ce qui dépasse le budget de %@ octets / %@ lignes du panneau latéral, il n'est donc pas affiché ici. Ouvrez le fichier dans un éditeur ou utilisez git diff --no-ext-diff HEAD -- <path> pour le consulter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "diff は %@ UTF-8 バイト / %@ 行あり、サイドパネルの上限（%@ バイト / %@ 行）を超えているためここには表示されません。エディタでファイルを開くか、git diff --no-ext-diff HEAD -- <path> を使用して確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diff 大小为 %@ 个 UTF-8 字节 / %@ 行，超过侧边栏 %@ 字节 / %@ 行的流畅预算，因此不在这里展示。请在编辑器中打开文件，或运行 git diff --no-ext-diff HEAD -- <path> 查看。"
          }
        }
      }
    },
