    "model-usage.footnote.estimated-usage" : {
      "comment" : "model usage footnote when some token usage is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "≈ means token split was estimated from older session data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "≈ indica que el reparto de tokens se estimó a partir de datos de sesiones anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "≈ signifie que la répartition des tokens a été estimée à partir de données de sessions plus anciennes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "≈ は、トークンの内訳が過去のセッションデータから推定されたことを示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "≈ 表示部分输入/输出令牌来自旧会话估算。"
          }
        }
      }
    },
    "model-usage.footnote.external-delegated" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delegated CLI calls are tracked separately because their real token usage and provider cache hits are not reported to WillDeep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas CLI delegadas se registran por separado porque su uso real de tokens y los aciertos de caché del proveedor no se reportan a WillDeep."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels CLI délégués sont suivis séparément, car leur consommation réelle de tokens et les hits de cache du fournisseur ne sont pas remontés à WillDeep."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委任されたCLI呼び出しは、実際のトークン使用量とプロバイダのキャッシュヒットがWillDeepに報告されないため、別途集計されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "委派的 CLI 调用会单独统计,因为它们真实的 token 用量和服务商缓存命中情况不会上报给 WillDeep。"
          }
        }
      }
    },
    "model-usage.footnote.unknown-and-estimated" : {
      "comment" : "model usage footnote when some prices are unknown and some token usage is estimated",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "n/a means no built-in price for that model; ≈ means older token data was estimated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "n/d significa que no hay precio integrado para ese modelo; ≈ significa que los datos de tokens antiguos se estimaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "n/d signifie qu'aucun tarif intégré n'existe pour ce modèle ; ≈ signifie que les données de tokens plus anciennes ont été estimées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "n/a はそのモデルの組み込み価格がないことを示し、≈ は過去のトークンデータが推定値であることを示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未定价表示内置价格表暂无该模型；≈ 表示旧会话令牌有估算。"
          }
        }
      }
    },
