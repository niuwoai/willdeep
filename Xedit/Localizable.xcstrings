    "settings.voice.status-installed-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mic button in composer is enabled. Press and hold to record, release to transcribe. Tip: hold the Fn key anywhere in the app for the same push-to-talk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón de micrófono del compositor está activado. Mantén pulsado para grabar y suelta para transcribir. Consejo: mantén pulsada la tecla Fn en cualquier parte de la app para la misma función de pulsar para hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton micro de la zone de saisie est activé. Maintenez-le enfoncé pour enregistrer, relâchez pour transcrire. Astuce : maintenez la touche Fn n'importe où dans l'application pour le même effet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンポーザーのマイクボタンが有効です。押し続けて録音し、離すと文字起こしされます。ヒント: アプリ内のどこでも Fn キーを押し続けると同じプッシュトゥトークが使えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入框里的麦克风按钮已启用。按住录音,松开转写。提示:在应用任意位置按住 Fn 键也能按住说话。"
          }
        }
      }
    },
