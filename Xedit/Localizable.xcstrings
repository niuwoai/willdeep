    "settings.workspace-wallpaper.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the shared wallpaper and image layout here. Agent workspace effects are controlled separately below. WillDeep keeps a private managed copy of custom images."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige aquí el fondo compartido y la disposición de la imagen. Los efectos del espacio de trabajo del Agente se controlan por separado más abajo. WillDeep guarda una copia privada y gestionada de las imágenes personalizadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ici le fond d'écran partagé et la disposition de l'image. Les effets de l'espace de travail de l'Agent se gèrent séparément ci-dessous. WillDeep conserve une copie privée gérée des images personnalisées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで共有壁紙と画像レイアウトを選択します。Agent ワークスペースのエフェクトは下で別途設定します。WillDeep はカスタム画像のプライベートな管理コピーを保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这里选择共享壁纸并调整图片布局；Agent 工作区效果可在下方单独控制。WillDeep 会为自定义图片保存一份仅供本机使用的副本。"
          }
        }
      }
    },
