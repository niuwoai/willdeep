    "composer.insert-secret.usage" : {
      "comment" : "Usage guidance shown in the protected secret insertion sheet",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use one row per password or token. After inserting, place the generated placeholders exactly where the command, header, or form field needs them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una fila por cada contraseña o token. Después de insertar, coloca los marcadores generados exactamente donde los necesite el comando, el encabezado o el campo del formulario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une ligne par mot de passe ou jeton. Après l'insertion, placez les espaces réservés générés exactement où la commande, l'en-tête ou le champ du formulaire en a besoin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1行につきパスワードまたはトークンを1つ入力してください。挿入後、生成されたプレースホルダーをコマンド、ヘッダー、フォームフィールドの必要な位置に配置してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行填写一个密码或 Token。插入后，把生成的占位符放到命令、请求头或表单字段真正需要的位置。"
          }
        }
      }
    },
