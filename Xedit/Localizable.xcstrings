    "agent-model-picker.selection-footer" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Selecting a model switches the provider and model for this conversation" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Seleccionar un modelo cambia el proveedor y el modelo de esta conversación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sélectionner un modèle change le fournisseur et le modèle pour cette conversation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデルを選択すると、この会話のプロバイダーとモデルが切り替わります" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择后将切换当前会话的供应商与模型" } } } },
