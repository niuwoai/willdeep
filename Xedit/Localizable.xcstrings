    "agent-panel.session-save-failed" : {
      "comment" : "error card body when writing the session JSON to disk fails",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to save this conversation to disk — recent messages may be lost after quitting. Check free disk space and folder permissions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar esta conversación en disco: los mensajes recientes podrían perderse al salir. Revisa el espacio libre en disco y los permisos de la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l'enregistrement de cette conversation sur le disque — les messages récents pourraient être perdus après la fermeture. Vérifiez l'espace disque disponible et les autorisations du dossier."
