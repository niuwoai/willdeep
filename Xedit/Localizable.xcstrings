      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to select the areas to erase or repaint. You can select multiple areas, then export a same-size PNG mask. White areas become the edit region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para seleccionar las áreas a borrar o repintar. Puedes seleccionar varias áreas y luego exportar una máscara PNG del mismo tamaño. Las áreas blancas se convierten en la región de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour sélectionner les zones à effacer ou à repeindre. Vous pouvez sélectionner plusieurs zones, puis exporter un masque PNG de même taille. Les zones blanches deviennent la zone d'édition."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして消去または再描画したい領域を選択します。複数の領域を選択したうえで、元画像と同じサイズの PNG マスクをエクスポートできます。白い領域が編集対象になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖拽框选要擦除或重绘的区域；可连续框选多块区域，然后导出同尺寸 PNG 蒙版。白色区域会作为编辑区域。"
          }
        }
      }
    },
