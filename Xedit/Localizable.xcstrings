    "settings.mobile-gateway.transport-mode-relay-caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Default. Connects through the public relay, so your phone works from anywhere with no local gateway to run. Session content is routed through the relay server (transport-encrypted, not yet end-to-end)." } },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predeterminado. Se conecta a través del relay público, de modo que tu teléfono funciona desde cualquier lugar sin necesidad de ejecutar un gateway local. El contenido de la sesión se enruta a través del servidor de relay (cifrado en el transporte, aún no de extremo a extremo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut. Se connecte via le relais public, ce qui permet à votre téléphone de fonctionner de n'importe où sans passerelle locale à exécuter. Le contenu de la session transite par le serveur de relais (chiffré au niveau du transport, pas encore de bout en bout)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルト。公共中継経由で接続するため、ローカルゲートウェイを実行しなくてもスマートフォンをどこからでも利用できます。セッション内容は中継サーバー経由で転送されます（転送層は暗号化済み、エンドツーエンド暗号化は未対応）。"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认。通过公共中继连接，手机在任何网络下都能用，无需运行本地网关。会话内容经中继服务器转发（传输层加密，尚未端到端加密）。" } }
      }
    },
    "settings.mobile-gateway.transport-mode-lan-caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Fallback. Runs a local gateway process for same-network pairing with per-device tokens — useful offline or on isolated networks." } },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativa. Ejecuta un proceso de gateway local para emparejar dentro de la misma red con tokens por dispositivo; útil sin conexión o en redes aisladas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secours. Exécute un processus de passerelle local pour un couplage sur le même réseau avec des jetons par appareil — utile hors ligne ou sur des réseaux isolés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォールバック。デバイスごとのトークンで同一ネットワーク内ペアリングを行うローカルゲートウェイプロセスを起動します。オフラインや隔離されたネットワークで有用です。"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "备选。启动本地网关进程，在同一网络内用按设备令牌配对——适合离线或隔离网络。" } }
      }
    },
    "settings.mobile-gateway.rotate-relay" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Rotate relay room" } },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotar sala de relay"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire tourner la salle de relais"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中継ルームをローテーション"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轮换中继房间" } }
      }
    },
    "settings.mobile-gateway.scan-hint-relay" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan this QR code with the WillDeep Android app to pair over the internet relay. Works off your local network." } },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea este código QR con la app WillDeep para Android para emparejar a través del relay por internet. Funciona fuera de tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez ce code QR avec l'application WillDeep Android pour vous coupler via le relais internet. Fonctionne en dehors de votre réseau local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep Android アプリでこの QR コードをスキャンし、インターネット中継経由でペアリングしてください。ローカルネットワーク外でも動作します。"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用 WillDeep 安卓 App 扫描此二维码，通过互联网中继配对。无需在同一局域网。" } }
      }
    },
    "settings.mobile-gateway.devices-relay-note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Relay mode shares one room token instead of per-device tokens. To de-authorize a phone, rotate the relay room — every paired device must re-scan." } },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo relay comparte un único token de sala en lugar de tokens por dispositivo. Para revocar el acceso a un teléfono, rota la sala de relay: todos los dispositivos emparejados deberán volver a escanear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode relais partage un seul jeton de salle au lieu de jetons par appareil. Pour révoquer un téléphone, faites tourner la salle de relais — chaque appareil couplé devra rescanner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中継モードではデバイスごとのトークンではなく、1つのルームトークンを共有します。特定のスマートフォンの認証を解除するには、中継ルームをローテーションしてください。ペアリング済みの全デバイスが再スキャンする必要があります。"
          }
        },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中继模式共用一个房间令牌，没有按设备令牌。要注销某台手机，请轮换中继房间——所有已配对设备都需重新扫码。" } }
      }
    },
