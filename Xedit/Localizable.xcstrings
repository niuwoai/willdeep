    "agent-model-picker.managed-login-required-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to some.im to enable Managed Routing. Coding Plan is optional and is not required." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录 some.im 后即可使用省心托管；Coding Plan 是可选套餐，不是使用前提。" } } } },
