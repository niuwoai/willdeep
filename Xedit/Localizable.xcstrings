    "composer.insert-secret.description" : {
      "comment" : "Description shown in the protected secret insertion sheet",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add up to three secrets. Each secret is saved locally in Keychain; the model only sees placeholders, and WillDeep resolves them when a local tool runs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次最多添加三个机密。每个机密只保存在本机钥匙串里；模型只会看到占位符，WillDeep 会在本地工具实际执行时再解析。"
          }
        }
      }
    },
