    "agent-model-picker.managed-judge-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A judge identifies the task and difficulty, chooses the working model, and validates the result." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Un juez identifica la tarea y su dificultad, elige el modelo de trabajo y valida el resultado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un juge identifie la tâche et sa difficulté, choisit le modèle d'exécution, puis valide le résultat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ジャッジがタスクの種類と難易度を判定し、実行モデルを選んで結果を検証します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "裁判负责判断任务类型和难度、选择干活模型，并对结果进行质量校验。" } } } },
    "agent-model-picker.managed-judge-title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Judge: selection and validation" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Juez: selección y validación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Juge : sélection et validation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ジャッジ：選定と検証" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "裁判模型：选型与校验" } } } },
    "agent-model-picker.managed-login-required-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to some.im to enable Managed Routing." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión en some.im para activar el enrutamiento gestionado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez-vous à some.im pour activer le routage géré." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マネージドルーティングを使うには some.im にサインインしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录 some.im 后即可使用省心托管。" } } } },
    "agent-model-picker.managed-login-required-title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to use Managed Routing" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión para usar el enrutamiento gestionado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez-vous pour utiliser le routage géré" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マネージドルーティングを使うにはサインインしてください" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录后可使用省心托管" } } } },
    "agent-model-picker.managed-not-selected-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation is using a specific model. Switch back when you want some.im to handle model selection." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta conversación usa un modelo específico. Vuelve a cambiar cuando quieras que some.im elija el modelo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette conversation utilise un modèle spécifique. Revenez-y quand vous voulez que some.im gère la sélection du modèle." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この会話では特定のモデルを使用しています。some.im にモデル選択を任せたい場合は切り替えてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前会话仍使用你选择的具体模型；需要自动选型时可切回省心托管。" } } } },
    "agent-model-picker.managed-not-selected-title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed Routing is not selected" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El enrutamiento gestionado no está seleccionado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le routage géré n'est pas sélectionné" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マネージドルーティングは選択されていません" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前没有选择省心托管" } } } },
    "agent-model-picker.managed-plan-independence" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed Routing works without Coding Plan. Coding Plan is a separate some.im package for coding usage." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El enrutamiento gestionado funciona sin el Coding Plan. El Coding Plan es un paquete independiente de some.im para uso de programación." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le routage géré fonctionne sans Coding Plan. Coding Plan est un forfait some.im distinct pour l'usage du codage." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マネージドルーティングは Coding Plan なしでも利用できます。Coding Plan はコーディング用途向けの別の some.im プランです。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "省心托管无需购买 Coding Plan；Coding Plan 只是 some.im 另行提供的编程套餐包。" } } } },
    "agent-model-picker.managed-rule" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "General tasks always use someim-auto-*; Coding Plan is used only for coding tasks" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Las tareas generales siempre usan someim-auto-*; el Coding Plan solo se usa para tareas de programación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les tâches générales utilisent toujours someim-auto-* ; Coding Plan n'est utilisé que pour les tâches de codage" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "汎用タスクは常に someim-auto-* を使用し、Coding Plan はコーディングタスクにのみ使用されます" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通用任务始终使用 someim-auto-*；Coding Plan 仅用于编程任务" } } } },
    "agent-model-picker.managed-selected-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation uses a judge to choose and validate the working model automatically." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta conversación usa un juez para elegir y validar automáticamente el modelo de trabajo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette conversation utilise un juge pour choisir et valider automatiquement le modèle d'exécution." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この会話ではジャッジが実行モデルを自動的に選択・検証します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前会话会由裁判自动选择干活模型，并对执行结果进行校验。" } } } },
    "agent-model-picker.managed-selected-title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed Routing is selected" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El enrutamiento gestionado está seleccionado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le routage géré est sélectionné" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マネージドルーティングが選択されています" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前已选择省心托管" } } } },
    "agent-model-picker.managed-subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically select a model" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Seleccionar un modelo automáticamente" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sélectionner un modèle automatiquement" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデルを自動選択" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动选择模型" } } } },
    "agent-model-picker.managed-worker-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A cost-efficient model tries first. If it cannot finish or validation fails, Managed Routing escalates automatically." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Un modelo económico lo intenta primero. Si no puede terminar o la validación falla, el enrutamiento gestionado escala automáticamente." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un modèle économique essaie d'abord. S'il n'y parvient pas ou si la validation échoue, le routage géré passe automatiquement à un modèle supérieur." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "まずコスト効率の良いモデルが処理を試みます。完了できないか検証に失敗した場合、マネージドルーティングが自動的に上位モデルへ切り替えます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先由低成本模型干活；实现不了或校验未通过时，再自动升档继续处理。" } } } },
    "agent-model-picker.managed-worker-title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Worker: cost first, capability when needed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Trabajador: costo primero, capacidad cuando se necesite" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Exécutant : coût d'abord, capacité si nécessaire" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ワーカー：コスト優先、必要時は能力を優先" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "干活模型：成本优先，能力兜底" } } } },
    "agent-model-picker.model-changed" : { "comment" : "Transcript notice shown when a conversation changes models. The placeholders are the previous and current model names.", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model changed from %@ to %@." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Modelo cambiado de %@ a %@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modèle changé de %@ à %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデルが %@ から %@ に変更されました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型已从 %@ 更改为 %@。" } } } },
