    "dispatch.profile-manager-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Workers bind WillDeep models or discovered external CLI profiles. Selected Workers execute graph nodes and fail over automatically." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Los Workers vinculan modelos de WillDeep o perfiles de CLI externos detectados. Los Workers seleccionados ejecutan los nodos del grafo y cambian automáticamente en caso de fallo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les Workers se lient à des modèles WillDeep ou à des profils CLI externes détectés. Les Workers sélectionnés exécutent les nœuds du graphe et basculent automatiquement en cas d'échec." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Worker は WillDeep モデルまたは自動検出された外部 CLI プロファイルに紐付けられます。選択した Worker はグラフのノードを実行し、利用不可の場合は自動的に切り替わります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Worker 可绑定 WillDeep 模型或自动发现的外部 CLI Profile；勾选后会执行任务图节点，并在不可用时自动切换。" } } } },
