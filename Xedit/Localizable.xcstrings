    "agent-delegation.profile-security-guard-purpose" : {
      "comment" : "User-facing description of the security guard trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decides whether a command is safe to run unattended. No tools — it judges the command, it never runs it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide si un comando puede ejecutarse sin supervisión. Sin herramientas: juzga el comando, nunca lo ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décide si une commande peut s'exécuter sans surveillance. Sans outils : elle juge la commande, ne l'exécute jamais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドを無人実行してよいかを判定します。ツールなし——判定するだけで、実行はしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "判断某条命令能否无人值守执行。无工具——只判断，从不执行。"
          }
        }
      }
    },
    "agent-delegation.profile-test-fixer-name" : {
      "comment" : "Display name of the test fixer subagent trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
