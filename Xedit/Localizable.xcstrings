    "settings.mcp.recommended-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add common MCP servers with safe defaults. Playwright uses npx -y so first launch does not stop at an interactive install prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade servidores MCP habituales con valores predeterminados seguros. Playwright usa npx -y para que el primer inicio no se detenga en una confirmación de instalación interactiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des serveurs MCP courants avec des réglages par défaut sûrs. Playwright utilise npx -y afin que le premier lancement ne s'arrête pas sur une invite d'installation interactive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全なデフォルト設定で一般的な MCP サーバーを追加します。Playwright は npx -y を使うため、初回起動時に対話式インストール確認で止まりません。"
          }
