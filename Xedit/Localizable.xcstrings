    "dispatch.force-executor" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Force executor" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Forzar ejecutor" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Forcer l'exécuteur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行者を強制指定" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "强制指定执行器" } } } },
    "dispatch.goal-command-placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "For example: let Codex run regression tests first, then ask Claude to review" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Por ejemplo: deja que Codex ejecute primero las pruebas de regresión y luego pide a Claude que revise" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Par exemple : laissez d'abord Codex exécuter les tests de régression, puis demandez à Claude de faire la revue" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "例：まず Codex に回帰テストを実行させ、その後 Claude にレビューさせる" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "例如：先让 Codex 跑回归测试，再请 Claude 复核" } } } },
    "dispatch.goal-command-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Send an instruction to this project" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Enviar una instrucción a este proyecto" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Envoyer une instruction à ce projet" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このプロジェクトに指示を送る" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "向这个项目发指令" } } } },
    "dispatch.goal-paused-launch" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume this project before launching another task." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Reanuda este proyecto antes de iniciar otra tarea." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reprenez ce projet avant de lancer une autre tâche." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいタスクを開始する前に、このプロジェクトを再開してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先恢复这个项目，再启动新任务。" } } } },
    "dispatch.project-already-running" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” is already the active dispatch project for this workspace. Open or pause it before starting another one." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "“%@” ya es el proyecto de despacho activo en este espacio de trabajo. Ábrelo o pausalo antes de iniciar otro." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "« %@ » est déjà le projet d'orchestration actif pour cet espace de travail. Ouvrez-le ou mettez-le en pause avant d'en démarrer un autre." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」はすでにこのワークスペースで実行中のディスパッチプロジェクトです。別のプロジェクトを開始する前に、これを開くか一時停止してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“%@” 已经是此工作区正在运行的调度项目。请先打开或暂停它，再启动另一个调度项目。" } } } },
    "dispatch.goal-assessment-action" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask AI to check the goal and draft acceptance criteria" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pedir a la IA que revise el objetivo y redacte los criterios de aceptación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Demander à l'IA de vérifier l'objectif et de rédiger les critères d'acceptation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "AI に目標を確認させ、受け入れ基準案を作成させる" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让 AI 检查目标并生成验收清单" } } } },
    "dispatch.goal-assessment-again" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check again" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Volver a revisar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifier à nouveau" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "再確認" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新检查" } } } },
    "dispatch.goal-assessment-analyzing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Analyzing the goal…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Analizando el objetivo…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Analyse de l'objectif…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "目標を分析中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在分析目标…" } } } },
    "dispatch.goal-assessment-can-ignore" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This is advice, not a gate. You can ignore it and create the project with the current checklist." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esto es solo una sugerencia, no un requisito. Puedes ignorarla y crear el proyecto con la lista de verificación actual." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ceci est un conseil, pas un verrou. Vous pouvez l'ignorer et créer le projet avec la liste de contrôle actuelle." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "これはあくまで提案であり、必須の関門ではありません。無視して現在のチェックリストのままプロジェクトを作成できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这只是建议，不是门禁；你可以忽略它，并用当前验收清单继续创建项目。" } } } },
    "dispatch.goal-assessment-failed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI goal check failed: %@" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Falló la revisión del objetivo por IA: %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Échec de la vérification de l'objectif par l'IA : %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "AI による目標確認に失敗しました：%@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 目标检查失败：%@" } } } },
    "dispatch.goal-assessment-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI will front-load missing decisions and fill an editable checklist so execution can run unattended." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La IA anticipará las decisiones pendientes y completará una lista de verificación editable para que la ejecución pueda avanzar sin supervisión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'IA anticipera les décisions manquantes et remplira une liste de contrôle modifiable afin que l'exécution puisse se dérouler sans surveillance." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "AI が不足している判断事項を先回りして洗い出し、編集可能なチェックリストに反映します。これにより実行を無人でも進めやすくなります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 会提前找出缺失的决策并填入可编辑清单，让启动后的执行尽量无人值守。" } } } },
    "dispatch.goal-assessment-missing-information" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add these decisions" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade estas decisiones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajouter ces décisions" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらの情報を追加してください" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "建议补充这些信息" } } } },
    "dispatch.goal-assessment-needs-revision" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This goal needs a little more focus" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Este objetivo necesita un poco más de enfoque" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cet objectif a besoin d'être un peu plus précis" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この目標はもう少し焦点を絞る必要があります" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个目标还需要再收敛一点" } } } },
    "dispatch.goal-assessment-ready" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This goal can converge" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Este objetivo puede converger" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cet objectif peut converger" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この目標は正常に収束できます" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个目标可以正常收敛" } } } },
    "dispatch.goal-assessment-stale" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The goal changed — check it again" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El objetivo cambió: vuelve a revisarlo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'objectif a changé — vérifiez-le à nouveau" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "目標が変更されました — 再確認してください" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目标已经修改，请重新检查" } } } },
    "dispatch.goal-assessment-stale-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The previous diagnosis no longer matches the current goal. Run the check again to refresh it." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El diagnóstico anterior ya no coincide con el objetivo actual. Vuelve a ejecutar la revisión para actualizarlo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le diagnostic précédent ne correspond plus à l'objectif actuel. Relancez la vérification pour l'actualiser." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "以前の診断結果は現在の目標と一致しなくなっています。もう一度確認して結果を更新してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上一次诊断已经不匹配当前目标，请重新检查以刷新结果。" } } } },
    "dispatch.goal-assessment-suggested-statement" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Suggested goal statement" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Enunciado de objetivo sugerido" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Énoncé d'objectif suggéré" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "推奨される目標の文言" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "建议的目标表述" } } } },
