    "settings.interface-skin.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a full-window skin. Skin changes apply to window chrome, sidebars, panels, selection color, and the recommended editor theme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una apariencia de ventana completa. Los cambios de apariencia se aplican al marco de la ventana, barras laterales, paneles, color de selección y al tema de editor recomendado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un habillage complet de la fenêtre. Les changements d'habillage s'appliquent au cadre de la fenêtre, aux barres latérales, aux panneaux, à la couleur de sélection et au thème d'éditeur recommandé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全画面スキンを選択します。スキンの変更は、ウィンドウの外枠、サイドバー、パネル、選択色、および推奨エディターテーマに適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择整窗界面皮肤。皮肤会应用到窗口、侧栏、面板、选中态，并同步推荐的编辑器主题。"
          }
        }
      }
    },
