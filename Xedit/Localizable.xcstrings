    "settings.memory.maintenance-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives duplicate or stale transient entries, removes expired archived entries, and records the last maintenance result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiva entradas temporales duplicadas u obsoletas, elimina entradas archivadas caducadas y registra el resultado del último mantenimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive les entrées temporaires dupliquées ou obsolètes, supprime les entrées archivées expirées et enregistre le résultat de la dernière maintenance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複または陳腐化した一時項目をアーカイブし、期限切れのアーカイブ項目を削除し、最新のメンテナンス結果を記録します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档重复或过期的临时条目、清除过期归档，并记录最近一次维护结果。"
          }
        }
      }
    },
