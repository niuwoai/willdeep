    "settings.mcp.marked-fully-trusted" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Marked %@ as fully trusted. All its calls now auto-run — writes included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ marcado como totalmente confiable. Todas sus llamadas ahora se ejecutan automáticamente, incluidas las de escritura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ marqué comme entièrement approuvé. Tous ses appels s'exécutent désormais automatiquement, écritures comprises."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を完全信頼としてマークしました。書き込みを含むすべての呼び出しが自動実行されます。"
          }
