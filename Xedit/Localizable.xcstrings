    "dispatch.plan-not-ready" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Wait for the planner to produce a validated task graph before launching Workers." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Espera a que el planificador genere un grafo de tareas validado antes de iniciar Workers." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Attendez que le planificateur produise un graphe de tâches validé avant de lancer les Workers." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Worker を起動する前に、プランナーが検証済みのタスクグラフを生成するまでお待ちください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请等待规划器生成并通过校验的任务图后再启动 Worker。" } } } },
