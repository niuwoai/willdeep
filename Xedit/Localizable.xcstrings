    "agent-project.remove-deletes" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This permanently deletes %@ conversation(s) and all their contents. This cannot be undone." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esto elimina permanentemente %@ conversación(es) y todo su contenido. Esta acción no se puede deshacer." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cela supprime définitivement %@ conversation(s) et tout leur contenu. Cette action est irréversible." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ 件の会話とすべての内容が完全に削除されます。この操作は元に戻せません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这会永久删除 %@ 个会话及其全部内容，且无法撤销。" } } } },
