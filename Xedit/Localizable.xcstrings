    "agent-model-picker.coding-plan-login-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign in to check an existing subscription, or open some.im to learn about and buy Coding Plan." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia sesión para consultar una suscripción existente, o abre some.im para conocer y comprar el Coding Plan." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez-vous pour vérifier un abonnement existant, ou ouvrez some.im pour découvrir et acheter Coding Plan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サインインして既存のサブスクリプションを確認するか、some.im を開いて Coding Plan の詳細を確認・購入できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录后可查看已有订阅；也可以前往 some.im 了解并购买 Coding Plan。" } } } },
