    "agent-profiles.hosted-model-overridden" : {
      "comment" : "Caption shown when a managed trade points at a model other than its hosted one",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overriding the recommended hosted model. This trade keeps its job prompt — WillDeep sends its own copy whenever the hosted model is not the one being called."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anulando el modelo alojado recomendado. Este oficio conserva su prompt de función: WillDeep envía su propia copia siempre que el modelo llamado no sea el alojado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacement du modèle hébergé recommandé. Ce métier conserve son invite : WillDeep envoie sa propre copie dès que le modèle appelé n’est pas celui hébergé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推奨のホスト型モデルを上書きしています。この職種の職能プロンプトは失われません。ホスト型モデル以外を呼ぶ場合は、WillDeep が同じ内容を自前で送ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
