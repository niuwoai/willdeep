    "goal-planning.budget-exhausted" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Goal paused: this execution segment ran out of budget. WillDeep asked for a handover snapshot. Press play to grant a new segment and continue." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Goal en pausa: este segmento de ejecución agotó su presupuesto. WillDeep solicitó una instantánea de traspaso. Pulsa reproducir para renovar el segmento y continuar." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Objectif en pause : ce segment d'exécution a épuisé son budget. WillDeep a demandé un instantané de passation. Appuyez sur lecture pour accorder un nouveau segment et continuer." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "目標は一時停止しました：この実行セグメントの予算を使い切りました。WillDeep は引き継ぎスナップショットの出力を要求しています。再生ボタンを押すと新しいセグメントを付与して続行できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Goal 已暂停：本段执行预算已用尽，WillDeep 已要求输出交接快照。点播放键可续期并继续。" } } } },
