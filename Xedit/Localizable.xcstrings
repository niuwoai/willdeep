    "settings.agent-behavior.appearance-description" : {
    "settings.agent-behavior.compression-model" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Compression Model" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Modelo de compresión" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modèle de compression" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "圧縮モデル" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "压缩模型" } } } },
    "settings.agent-behavior.compression-model-description" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Summarizes older turns when the context window fills up. Prefer a large context window over raw speed: the window sets how many chunks a long transcript is split into, and each chunk is a separate request. Avoid reasoning models — a truncated summary silently loses conversation state. Empty → falls back to the active provider's Flash model." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Resume los turnos antiguos cuando la ventana de contexto se llena. Prioriza una ventana de contexto grande sobre la velocidad pura: la ventana determina en cuántos fragmentos se divide una transcripción larga, y cada fragmento es una solicitud independiente. Evita los modelos de razonamiento: un resumen truncado pierde silenciosamente el estado de la conversación. Vacío → recurre al modelo Flash del proveedor activo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Résume les tours anciens lorsque la fenêtre de contexte se remplit. Privilégiez une grande fenêtre de contexte plutôt que la vitesse brute : la fenêtre détermine en combien de fragments une longue transcription est découpée, et chaque fragment est une requête distincte. Évitez les modèles de raisonnement — un résumé tronqué perd silencieusement l'état de la conversation. Vide → revient au modèle Flash du fournisseur actif." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コンテキストウィンドウが埋まってきたら、古いやり取りを要約します。生の速度よりも大きなコンテキストウィンドウを優先してください。ウィンドウのサイズが長い記録を何個のチャンクに分割するかを決め、各チャンクが個別のリクエストになります。推論モデルは避けてください——要約が途中で切れると会話の状態が静かに失われます。空欄 → 現在のプロバイダのFlashモデルにフォールバック。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上下文窗口接近占满时，把较早的对话折叠成摘要。选型优先看上下文窗口大小而非出词速度：窗口决定长转录被切成多少块，每块都是一次独立请求。不要用推理模型——摘要被截断会静默丢失会话状态。留空 → 回退到当前 provider 的 Flash 模型。" } } } },
    "settings.agent-behavior.compression-model-placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "(leave empty → use Flash model)" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "(dejar vacío → usar el modelo Flash)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "(laisser vide → utiliser le modèle Flash)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "（空欄のまま → Flashモデルを使用）" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "（留空 → 使用 Flash 模型）" } } } },
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base size (pt) for Agent chat message body and rendered Markdown blocks (paragraphs, lists, quotes, fenced code, tables). Tool-call summaries, footers, message headers, and composer chrome keep their fixed sizes — this knob is about reading the conversation, not resizing the whole UI. Default is 15 pt; range %1$@ – %2$@ pt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño base (pt) del cuerpo de los mensajes del chat del Agente y de los bloques Markdown renderizados (párrafos, listas, citas, código en bloque, tablas). Los resúmenes de llamadas a herramientas, pies de página, cabeceras de mensaje y la barra del compositor mantienen su tamaño fijo — este ajuste es para leer la conversación, no para redimensionar toda la interfaz. El valor predeterminado es 15 pt; rango %1$@ – %2$@ pt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille de base (pt) du corps des messages du chat Agent et des blocs Markdown rendus (paragraphes, listes, citations, blocs de code, tableaux). Les résumés d'appels d'outils, les pieds de page, les en-têtes de message et l'interface de saisie conservent leur taille fixe — ce réglage sert à lire la conversation, pas à redimensionner toute l'interface. Valeur par défaut : 15 pt ; plage %1$@ – %2$@ pt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentチャット本文とレンダリングされたMarkdownブロック（段落、リスト、引用、コードブロック、表）の基本サイズ（pt）。ツール呼び出しの要約、フッター、メッセージヘッダー、入力欄のUIは固定サイズのままです — この設定は会話を読みやすくするためのもので、UI全体を拡大縮小するものではありません。デフォルトは15pt、範囲は %1$@ – %2$@ pt です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 聊天正文和 Markdown 块（段落、列表、引用、代码块、表格）的基础字号（pt）。工具卡片摘要、底栏、消息头、输入框工具栏会保持固定字号 — 这个旋钮只管「读对话」，不会缩放整个 UI。默认 15 pt；范围 %1$@ – %2$@ pt。"
          }
        }
      }
    },
    "settings.agent-behavior.anthropic-max-output-tokens" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Anthropic reply limit" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Límite de respuesta de Anthropic" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Limite de réponse Anthropic" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Anthropic 応答上限" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Anthropic 回复上限" } } } },
    "settings.agent-behavior.anthropic-max-output-tokens-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Maximum tokens a single Anthropic reply may produce (max_tokens). Default 32K keeps long documents and large refactor replies from truncating; legacy Claude 3.x models are automatically clamped to their lower API caps." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Número máximo de tokens que puede generar una sola respuesta de Anthropic (max_tokens). El valor predeterminado de 32K evita que se trunquen documentos largos y respuestas de refactorización grandes; los modelos antiguos Claude 3.x se limitan automáticamente a sus topes de API más bajos." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nombre maximal de tokens qu'une réponse Anthropic peut produire (max_tokens). La valeur par défaut de 32K évite que les longs documents et les réponses de refactorisation volumineuses soient tronqués ; les anciens modèles Claude 3.x sont automatiquement bridés à leurs plafonds d'API inférieurs." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "1回のAnthropic応答が生成できる最大トークン数（max_tokens）。デフォルトの32Kにより、長文ドキュメントや大規模なリファクタリング応答が途中で切れることを防ぎます。旧世代のClaude 3.xモデルは、そのAPI上限に合わせて自動的に制限されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "单次 Anthropic 回复允许生成的最大 token 数（max_tokens）。默认 32K，长文档与大型重构回复不再被截断；旧的 Claude 3.x 系列会自动收紧到其 API 上限。" } } } },
    "settings.agent-behavior.concurrency-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap on simultaneous Agent turns per provider. Each provider has its own quota — running 3 DashScope sessions doesn't block OpenAI sessions. When the cap is hit, new dispatches queue (FIFO) and drain as turns finish. Raising the cap immediately promotes queued work; lowering it just stops promoting new ones (running turns are never aborted). Default 3 is conservative — bump up if your provider's rate limit comfortably allows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite de turnos simultáneos del Agente por proveedor. Cada proveedor tiene su propia cuota — ejecutar 3 sesiones de DashScope no bloquea las sesiones de OpenAI. Al alcanzar el límite, los nuevos envíos se encolan (FIFO) y se procesan a medida que terminan los turnos. Subir el límite promueve de inmediato el trabajo en cola; bajarlo solo deja de promover nuevas tareas (los turnos en curso nunca se interrumpen). El valor predeterminado de 3 es conservador — auméntalo si el límite de tasa de tu proveedor lo permite con holgura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plafond de tours Agent simultanés par service. Chaque service a son propre quota — exécuter 3 sessions DashScope ne bloque pas les sessions OpenAI. Une fois le plafond atteint, les nouvelles demandes sont mises en file (FIFO) et traitées au fur et à mesure que les tours se terminent. Augmenter le plafond fait immédiatement avancer le travail en attente ; le réduire empêche seulement d'en promouvoir de nouveaux (les tours en cours ne sont jamais interrompus). La valeur par défaut de 3 est prudente — augmentez-la si la limite de débit de votre service le permet confortablement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーごとに同時実行できるAgentターン数の上限。各プロバイダーは独立した割り当てを持ちます — DashScopeセッションを3つ実行してもOpenAIセッションはブロックされません。上限に達すると、新しいディスパッチはFIFOでキューに入り、ターンが終わるごとに処理されます。上限を上げるとキュー内の作業が即座に昇格し、下げると新規の昇格が止まるだけです（実行中のターンが中断されることはありません）。デフォルトの3は控えめな設定です — プロバイダーのレート制限に余裕があれば引き上げてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个服务商可以同时跑的 Agent 回合数上限。每个服务商有独立配额——同时跑 3 个 DashScope 会话不会挡 OpenAI 会话。达到上限后新请求按先来后到入队，等回合结束再依次释放。调高立刻放行排队中的任务；调低只是不再放新任务（运行中的回合永远不会被中断）。默认 3 比较保守——服务商限流够宽就可以调大。"
          }
        }
      }
    },
    "settings.agent-behavior.save-note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keystrokes stay local until you press Save (⌘↩). API keys are stored separately in Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pulsaciones de teclas permanecen locales hasta que pulses Guardar (⌘↩). Las claves de API se guardan por separado en el llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La saisie reste locale tant que vous n'avez pas cliqué sur Enregistrer (⌘↩). Les clés API sont stockées séparément dans le trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力内容は保存（⌘↩）を押すまでローカルに留まります。API Keyは別途Keychainに保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入仅在按下保存（⌘↩）后才会落盘。API Key 单独保存在 Keychain。"
          }
        }
      }
    },
    "settings.agent-behavior.title-model" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Title Model"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo de título"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle de titrage"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルモデル"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标题模型"
          }
        }
      }
    },
    "settings.agent-behavior.title-model-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A short one-shot completion summarizes each new chat into a ≤12-char title after the first assistant reply. Set a cheap/fast model here (e.g. `deepseek-chat`, `gpt-4o-mini`, `qwen-turbo`) to avoid burning Pro tokens on titling. Empty → falls back to the active provider's Flash model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una completación breve y única resume cada chat nuevo en un título de ≤12 caracteres tras la primera respuesta del asistente. Especifica aquí un modelo barato/rápido (p. ej. `deepseek-chat`, `gpt-4o-mini`, `qwen-turbo`) para no gastar tokens de Pro en titular. Vacío → recurre al modelo Flash del proveedor activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une courte complétion ponctuelle résume chaque nouvelle conversation en un titre de ≤12 caractères après la première réponse de l'assistant. Indiquez ici un modèle rapide et économique (par ex. `deepseek-chat`, `gpt-4o-mini`, `qwen-turbo`) pour éviter de consommer des tokens Pro pour le titrage. Vide → utilise par défaut le modèle Flash du service actif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のアシスタント返信の後、短い1回限りの補完で各新規チャットを12文字以内のタイトルに要約します。ここに安価で高速なモデル（例：`deepseek-chat`、`gpt-4o-mini`、`qwen-turbo`）を設定すると、タイトル生成でProトークンを消費せずに済みます。空欄の場合 → 現在のプロバイダーのFlashモデルにフォールバックします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首条助手回复后用一次性短补全把对话压成 ≤12 字标题。在这里指定一个便宜/快的模型（如 `deepseek-chat`、`gpt-4o-mini`、`qwen-turbo`），避免起标题烧 Pro token。留空 → 回退到当前服务商的 Flash 模型。"
          }
        }
      }
    },
    "settings.agent-behavior.title-model-placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(leave empty → use Flash model)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(dejar vacío → usar el modelo Flash)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(laisser vide → utiliser le modèle Flash)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（空欄のまま → Flashモデルを使用）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（留空 → 使用 Flash 模型）"
          }
        }
      }
    },
    "settings.agent-behavior.tool-approval-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only shell commands in the built-in allowlist (cat, head, tail, ls, find without -delete/-exec, git diff/log/status/show, rg, grep, wc, file, stat, which, pwd, echo, …) run without asking. Commands outside the allowlist are passed to a one-shot LLM judge running on the active provider's **Flash** model (cheap & fast — never Pro), and only YES verdicts auto-run. Destructive patterns (rm, sudo, git push --force, git reset --hard, …) still require typing \"confirm\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comandos de shell de solo lectura de la lista blanca integrada (cat, head, tail, ls, find sin -delete/-exec, git diff/log/status/show, rg, grep, wc, file, stat, which, pwd, echo, …) se ejecutan sin preguntar. Los comandos fuera de la lista blanca se envían a un juez LLM de una sola vez que se ejecuta en el modelo **Flash** del proveedor activo (barato y rápido — nunca Pro), y solo los veredictos YES se ejecutan automáticamente. Los patrones destructivos (rm, sudo, git push --force, git reset --hard, …) siguen requiriendo escribir \"confirm\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes shell en lecture seule de la liste blanche intégrée (cat, head, tail, ls, find sans -delete/-exec, git diff/log/status/show, rg, grep, wc, file, stat, which, pwd, echo, …) s'exécutent sans demander de confirmation. Les commandes hors liste blanche sont soumises à un juge LLM ponctuel exécuté sur le modèle **Flash** du service actif (économique et rapide — jamais Pro), et seul un verdict YES déclenche l'exécution automatique. Les schémas destructeurs (rm, sudo, git push --force, git reset --hard, …) exigent toujours de taper \"confirm\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みの許可リストにある読み取り専用のshellコマンド（cat、head、tail、ls、-delete/-execを含まないfind、git diff/log/status/show、rg、grep、wc、file、stat、which、pwd、echoなど）は確認なしで実行されます。許可リスト外のコマンドは、現在のプロバイダーの**Flash**モデル（安価で高速 — Proは使用しません）で動作する一回限りのLLM判定に渡され、YESの判定のみ自動実行されます。破壊的なパターン（rm、sudo、git push --force、git reset --hardなど）は引き続き\"confirm\"の入力が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置只读白名单里的 shell 命令（cat、head、tail、ls、不带 -delete/-exec 的 find、git diff/log/status/show、rg、grep、wc、file、stat、which、pwd、echo 等）直接执行不会询问。名单之外的命令交给一次性 LLM 判官，跑在当前服务商的 **Flash** 模型（便宜快速 — 绝不走 Pro），只有 YES 才自动执行。破坏性命令（rm、sudo、git push --force、git reset --hard 等）仍需手动输入 \"confirm\"。"
          }
        }
      }
    },
