          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトはシステムに従うです。確定的な音声入力テストが必要な場合は、日本語など固定の言語を選択してください。"
          }
        },
        "zh-Hans" : {
