    "settings.computer-use.accessibility-detail" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Required to click, type, scroll, and inspect app controls." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Necesario para hacer clic, escribir, desplazarse e inspeccionar controles de la aplicación." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nécessaire pour cliquer, saisir du texte, faire défiler et inspecter les contrôles des applications." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "クリック、入力、スクロール、アプリコントロールの検査に必要です。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于点击、输入、滚动和读取应用控件。" } } } },
    "settings.computer-use.accessibility-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Accesibilidad" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Accessibilité" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセシビリティ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能" } } } },
    "settings.computer-use.explanation" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "These permissions belong to the separately signed WillDeep Computer Use helper. Granting them to the main WillDeep app does not grant them to the helper. System audio is not recorded or saved by Computer Use." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Estos permisos pertenecen al asistente WillDeep Computer Use, firmado por separado. Concederlos a la aplicación principal de WillDeep no se los concede al asistente. Computer Use no graba ni guarda el audio del sistema." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ces autorisations appartiennent à l'assistant WillDeep Computer Use, signé séparément. Les accorder à l'application principale WillDeep ne les accorde pas à l'assistant. Computer Use n'enregistre ni ne conserve l'audio système." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらの権限は、個別に署名されたWillDeep Computer Useヘルパーに属します。メインのWillDeepアプリに権限を付与しても、ヘルパーには付与されません。Computer Useはシステムオーディオを録音・保存しません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些权限属于独立签名的 WillDeep Computer Use 辅助程序；授权 WillDeep 主程序并不会同时授权该辅助程序。Computer Use 不会录制或保存系统音频。" } } } },
    "settings.computer-use.helper-name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep Computer Use" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep Computer Use" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep Computer Use" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep Computer Use" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep Computer Use" } } } },
    "settings.computer-use.refresh-button-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh permission status" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Actualizar estado del permiso" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Actualiser l'état des autorisations" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "権限状態を更新" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "刷新权限状态" } } } },
    "settings.computer-use.request-button" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Request Permission" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solicitar permiso" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Demander l'autorisation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "権限をリクエスト" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "申请权限" } } } },
    "settings.computer-use.screen-capture-detail" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Required to capture the visible interface and verify Computer Use results." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Necesario para capturar la interfaz visible y verificar los resultados de Computer Use." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nécessaire pour capturer l'interface visible et vérifier les résultats de Computer Use." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "表示中のインターフェースをキャプチャし、Computer Useの結果を検証するために必要です。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于捕获可见界面并验证 Computer Use 操作结果。" } } } },
    "settings.computer-use.screen-capture-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen & System Audio Recording" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Grabación de pantalla y audio del sistema" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Enregistrement de l'écran et de l'audio système" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画面とシステムオーディオの録画" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕与系统音频录制" } } } },
