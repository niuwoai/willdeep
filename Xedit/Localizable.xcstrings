          }
        }
      }
    },
    "agent-delegation.profile-git-detective-purpose" : {
      "comment" : "User-facing description of the git detective trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answers repository-history questions such as which commit introduced a regression. Never modifies the repository."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde preguntas sobre el historial del repositorio, como qué commit introdujo una regresión. Nunca modifica el repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répond aux questions sur l'historique du dépôt, comme le commit à l'origine d'une régression. Ne modifie jamais le dépôt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのコミットがリグレッションを招いたかなど、リポジトリ履歴の質問に答えます。リポジトリを変更することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答仓库历史问题，例如哪个提交引入了回归。从不修改仓库。"
          }
        }
      }
    },
    "agent-delegation.profile-hosted-model-locked" : {
      "comment" : "Settings label shown when a trade's model is managed by some.im",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model and prompt hosted by some.im"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo y prompt alojados por some.im"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle et prompt hébergés par some.im"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルとプロンプトは some.im が管理"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型与提示词由 some.im 托管"
          }
        }
      }
    },
    "agent-delegation.profile-hosted-model-locked-hint" : {
      "comment" : "Explanation for why a hosted trade's model cannot be changed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While the current provider is some.im this trade runs on a managed model with a server-side prompt. Choose a private provider to keep the trade on that provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras el proveedor actual sea some.im, este oficio usa un modelo gestionado con prompt en el servidor. Elige un proveedor privado para mantener allí el oficio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que le fournisseur actuel est some.im, ce métier utilise un modèle géré avec un prompt côté serveur. Choisissez un fournisseur privé pour y conserver ce métier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のプロバイダーが some.im の場合、この職能はサーバー側プロンプト付きの管理モデルで動作します。プライベートプロバイダーを選ぶと、そのプロバイダー内で実行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 Provider 为 some.im 时，该工种使用托管模型与服务端提示词；选择私有 Provider 后，工种会留在该 Provider 内执行。"
          }
        }
      }
    },
    "agent-delegation.profile-judge-name" : {
      "comment" : "Display name of the judge subagent trade",
      "extractionState" : "manual",
      "localizations" : {
