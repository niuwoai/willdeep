    "agent-model-picker.coding-plan-checking-hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your package name and expiration date will appear here." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El nombre del paquete y la fecha de vencimiento aparecerán aquí." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le nom de votre forfait et sa date d'expiration s'afficheront ici." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プラン名と有効期限がここに表示されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查询完成后会在这里显示套餐名称和到期日期。" } } } },
