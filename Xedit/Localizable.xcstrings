    "dispatch.graph-summary-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Graph Summary" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Resumen del grafo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Résumé du graphe" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "グラフ概要" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "图概览" } } } },
    "dispatch.graph-tasks" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tasks" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tareas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tâches" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "タスク" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "任务" } } } },
    "dispatch.graph-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Task Graph" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Grafo de tareas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Graphe de tâches" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "タスクグラフ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "任务图工程台" } } } },
    "dispatch.human-override" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Human Override" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Intervención humana" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Intervention humaine" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "手動介入" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "人工干预" } } } },
    "dispatch.hide-instructions" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hide Instructions" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ocultar instrucciones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Masquer les instructions" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行指示を隠す" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "收起运行指令" } } } },
    "dispatch.interrupt-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep will preserve existing output, stop the current round, and apply the new instruction next." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep conservará la salida existente, detendrá la ronda actual y aplicará la nueva instrucción a continuación." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep conservera la sortie existante, arrêtera le tour en cours, puis appliquera la nouvelle instruction." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep は既存の出力を保持し、現在のラウンドを停止した上で、次に新しい指示を適用します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep 会保留已有输出，停止当前轮次，并在下一轮优先应用新指令。" } } } },
    "dispatch.interrupt-now" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Interrupt Now" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Interrumpir ahora" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Interrompre maintenant" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "今すぐ中断" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "立即中断" } } } },
    "dispatch.interrupt-required" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirmation required · current execution will be interrupted" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Confirmación necesaria · se interrumpirá la ejecución actual" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Confirmation requise · l'exécution en cours sera interrompue" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "確認が必要です · 現在の実行が中断されます" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要确认 · 将中断当前执行" } } } },
    "dispatch.interrupt-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Interrupt the current project execution?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Interrumpir la ejecución actual del proyecto?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Interrompre l'exécution en cours du projet ?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のプロジェクトの実行を中断しますか？" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中断当前项目执行？" } } } },
    "dispatch.keep-running" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Running" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Seguir ejecutando" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Continuer l'exécution" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行を継続" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续运行" } } } },
    "dispatch.acceptance-recovery-exhausted" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The node Harness could not satisfy every acceptance criterion within its bounded recovery budget. The node has failed explicitly instead of remaining stuck in review." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El nodo Harness no pudo cumplir todos los criterios de validación dentro de su presupuesto limitado de recuperación. El nodo ha fallado de forma explícita en lugar de quedarse atascado en revisión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le nœud Harness n'a pas pu satisfaire tous les critères de validation dans son budget de récupération limité. Le nœud a échoué explicitement plutôt que de rester bloqué en révision." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードHarnessは、限られたリカバリー予算内ですべての検収基準を満たせませんでした。ノードは「レビュー中」のまま停滞させず、明示的に失敗として扱われました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "节点 Harness 在有限恢复预算内未能满足全部验收标准。节点已明确失败，不会继续停滞在“验收中”。" } } } },
    "dispatch.launch-failed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to launch task" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo iniciar la tarea" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de lancer la tâche" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "タスクを開始できません" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法启动任务" } } } },
    "dispatch.launch-task" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Launch Task" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Iniciar tarea" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Lancer la tâche" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "タスクを開始" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动任务" } } } },
    "dispatch.mark-successful-and-continue" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mark Successful & Continue" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Marcar como correcto y continuar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Marquer comme réussi et continuer" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "成功として続行" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "标记成功并继续" } } } },
    "dispatch.mark-successful-and-continue-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Override the automated verdict, complete this node, and launch newly unblocked nodes." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Sustituye el veredicto automático, completa este nodo e inicia los nodos desbloqueados." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Remplace le verdict automatique, termine ce nœud et lance les nœuds débloqués." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動判定を上書きしてこのノードを完了し、解除された後続ノードを開始します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "覆盖自动判定，将此节点设为完成，并启动刚刚解锁的后续节点。" } } } },
    "dispatch.mark-successful-confirmation-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use this only after reviewing the task evidence. WillDeep will override the automated verdict, unlock dependent nodes, and continue execution." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Úsalo solo tras revisar las pruebas. WillDeep sustituirá el veredicto automático, desbloqueará los nodos dependientes y continuará." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilisez cette action après vérification des preuves. WillDeep remplacera le verdict automatique, débloquera les nœuds dépendants et poursuivra l’exécution." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "タスクの証拠を確認した後に使用してください。自動判定を上書きし、依存ノードを解除して実行を続けます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请仅在核对任务证据后使用。WillDeep 将覆盖自动判定、解锁依赖节点并继续执行。" } } } },
    "dispatch.mark-successful-confirmation-title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mark this node successful?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Marcar este nodo como correcto?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Marquer ce nœud comme réussi ?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このノードを成功として扱いますか？" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将此节点标记为成功？" } } } },
    "dispatch.stop-task" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Node" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Detener nodo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Arrêter le nœud" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノードを停止" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止节点" } } } },
    "dispatch.stop-task-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Interrupt this node's current turn and mark it stopped. Other nodes keep running; the node can be launched again later." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Interrumpe la ronda actual de este nodo y márcalo como detenido. Los demás nodos siguen ejecutándose; este nodo puede iniciarse de nuevo más tarde." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Interrompt le tour en cours de ce nœud et le marque comme arrêté. Les autres nœuds continuent de s'exécuter ; ce nœud pourra être relancé plus tard." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このノードの現在のターンを中断し、停止済みとしてマークします。他のノードは実行を継続し、このノードは後で再度起動できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中断该节点当前这一轮并标记为已停止。项目内其他节点继续运行，之后可以重新启动这个节点。" } } } },
    "dispatch.local-environment" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This Mac" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Este Mac" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce Mac" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac" } } } },
    "dispatch.manage-profiles" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage Profiles…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Administrar perfiles…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Gérer les profils…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロファイルを管理…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "管理 Profile…" } } } },
    "dispatch.selected-worker-count" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ Workers" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ Workers" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ Workers" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ 個の Worker" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 个 Worker" } } } },
    "dispatch.worker-pool-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One Worker profile can run multiple ready nodes in parallel. Add profiles to extend the model pool and failover order." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Un perfil de Worker puede ejecutar varios nodos listos en paralelo. Añade perfiles para ampliar el conjunto de modelos y el orden de conmutación por error." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un profil Worker peut exécuter plusieurs nœuds prêts en parallèle. Ajoutez des profils pour étendre le pool de modèles et l'ordre de basculement." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "1 つの Worker プロファイルで複数の準備完了ノードを並行実行できます。プロファイルを追加してモデルプールとフェイルオーバー順序を拡張してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一个 Worker Profile 可并行执行多个就绪节点；补选多个 Profile 用于扩展模型池与故障转移顺序。" } } } },
    "dispatch.worker-unavailable" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unavailable" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No disponible" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Indisponible" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用不可" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不可用" } } } },
    "dispatch.workers" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Workers" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Workers" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Workers" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Worker" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Worker" } } } },
    "dispatch.map-workspace-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose another checkout of this project." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige otra copia local de este proyecto." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez un autre checkout de ce projet." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このプロジェクトの別のチェックアウトを選択してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请选择当前项目的另一个工作目录。" } } } },
    "dispatch.model-id" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model ID" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "ID del modelo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "ID du modèle" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "モデル ID" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型 ID" } } } },
    "dispatch.model-switch-applies-next-turn" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ will be used from the next turn" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ se usará a partir de la próxima ronda" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ sera utilisé à partir du prochain tour" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "次のターンから %@ が使用されます" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一轮起使用 %@" } } } },
    "dispatch.model-switch-safe-point-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A running request keeps its current model. The selection applies from the next turn." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Una solicitud en curso mantiene su modelo actual. La selección se aplica desde la próxima ronda." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une requête en cours conserve son modèle actuel. La sélection s'applique à partir du prochain tour." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行中のリクエストは現在のモデルのまま継続します。新しい選択は次のターンから適用されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前请求继续使用原模型，新选择从下一轮生效。" } } } },
