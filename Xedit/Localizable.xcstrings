    "settings.connectors.auth.oauth-help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "User-authorized access for docs, drive, chat, and future write actions. Tokens belong in Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso autorizado por el usuario a documentos, unidad, chat y futuras acciones de escritura. Los tokens deben guardarse en el llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès autorisé par l'utilisateur pour les documents, le cloud, le chat et les futures actions d'écriture. Les tokens doivent être stockés dans le trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドキュメント、ドライブ、チャット、および今後の書き込み操作に対するユーザー認可アクセスです。TokenはKeychainに保存してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户授权访问文档、云盘、聊天和后续写入动作，token 应存入 Keychain。"
          }
        }
      }
    },
