    "agent-profiles.delete-message" : {
      "comment" : "Warns what deleting a profile affects",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will stop being offered to spawn_agent and to dispatch nodes. Nodes already assigned to it fall back to the default trade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dejará de ofrecerse a spawn_agent y a los nodos de despacho. Los nodos ya asignados a él volverán al oficio predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne sera plus proposé à spawn_agent ni aux nœuds de répartition. Les nœuds déjà associés reviendront au métier par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は spawn_agent やディスパッチノードの選択肢に表示されなくなります。すでに割り当てられているノードはデフォルトの職種にフォールバックします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将不再出现在 spawn_agent 与调度台可选项里。已指派给它的节点会回退到默认工种。"
          }
        }
      }
    },
