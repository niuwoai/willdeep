    "agent-image-editor.someim.help" : {
      "comment" : "Footnote for the some.im provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "some.im submits with the image, mask, and prompt fields; adjust the endpoint to match your relay service routing. Erase mode automatically uses a basic erase prompt when no prompt is given."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "some.im envía con los campos image, mask y prompt; ajusta el endpoint para que coincida con el enrutamiento de tu servicio de relay. El modo de borrado usa automáticamente un prompt de borrado básico cuando no se indica ninguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "some.im envoie les champs image, mask et prompt ; ajustez l'endpoint selon le routage de votre service relais. Le mode Effacer utilise automatiquement une consigne d'effacement basique si aucune consigne n'est fournie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "some.im は image、mask、prompt の各フィールドで送信します。中継サービスのルーティングに合わせてエンドポイントを調整してください。消去モードでは、プロンプトが指定されていない場合に基本的な消去プロンプトが自動的に使用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "some.im 会使用 image、mask、prompt 字段提交，可按中转服务实际路由调整 endpoint。擦除模式在没有提示词时会自动使用基础擦除提示。"
          }
        }
      }
    },
