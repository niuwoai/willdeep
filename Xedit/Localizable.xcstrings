    "consultation.setup-description" : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep elabora primero una propuesta inicial; los expertos seleccionados la revisan de forma independiente, luego se cuestionan entre sí en una ronda y, por último, WillDeep redacta la conclusión final. Todas las revisiones externas son de solo lectura." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep produit d'abord une première version ; les experts sélectionnés l'évaluent indépendamment, puis se questionnent mutuellement lors d'un tour, avant que WillDeep ne rédige la synthèse finale. Toutes les évaluations externes sont en lecture seule." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "まずWillDeepが初期案を提示し、選択したエキスパートが個別にレビューした後、1回の相互質問を行い、最後にWillDeepがまとめて最終案を作成します。外部レビューはすべて読み取り専用です。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "WillDeep 先出初版；所选专家独立评审、再相互质询一轮，最后由 WillDeep 汇总定稿。所有外部评审均为只读。" } } }
    },
    "consultation.setup-overview" : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige el modo de discusión y al menos dos expertos locales; todas las intervenciones de expertos externos son de solo lectura." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez un mode de discussion et au moins deux experts locaux ; toutes les interventions des experts externes sont en lecture seule." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "議論の方式と、ローカルのエキスパートを2名以上選択してください。外部エキスパートの発言はすべて読み取り専用です。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择讨论方式和至少两位本机专家；所有外部专家发言均为只读。" } } }
    },
    "consultation.setup-title" : {
      "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Consulta multiexperto" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Consultation multi-experts" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マルチエキスパート会議" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "多专家会诊" } } }
