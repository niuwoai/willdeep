        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请检查当前项目是否存在明显风险：未提交变更、TODO/FIXME 标记、最近修改的关键文件，以及任何可能需要我注意的事项。请汇总发现和下一步行动。" } }
      }
