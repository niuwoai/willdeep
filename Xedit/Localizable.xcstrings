    "agent-profiles.prompt-note" : {
      "comment" : "Explains which prompt half is editable",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appended after the trade's built-in section. The runner's own rules — read-only boundary, “your final message is the deliverable”, “you cannot ask the user” — are not editable here: they exist because models violated them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añade después de la sección integrada del oficio. Las reglas propias del runner —el límite de solo lectura, “tu último mensaje es el entregable”, “no puedes preguntarle al usuario”— no se pueden editar aquí: existen porque los modelos las han violado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouté après la section intégrée du métier. Les règles propres au runner — limite lecture seule, « votre dernier message est le livrable », « vous ne pouvez pas interroger l'utilisateur » — ne sont pas modifiables ici : elles existent parce que des modèles les ont enfreintes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職種組み込みのセクションの後に追加されます。ランナー自身のルール（読み取り専用の境界、「最後のメッセージが成果物である」、「ユーザーに質問できない」）はここでは編集できません。これらはモデルが違反したことがあるために存在します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会拼在工种自带的提示词之后。runner 的几条不变量（只读边界、「最后一条消息就是交付物」、「不能问用户」）不在这里改——它们的存在正是因为模型违反过。"
          }
        }
      }
    },
    "agent-profiles.soul-external-note" : {
      "comment" : "Explains why soul is disabled for external CLI profiles",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This profile runs on an external CLI, which brings its own harness. Prompt and skills configured here would not be delivered, so they are disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil se ejecuta en un CLI externo, que trae su propio harness. El prompt y las habilidades configurados aquí no se transmitirían, por lo que están desactivados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil s'exécute sur un CLI externe, qui apporte son propre harnais. Le prompt et les compétences configurés ici ne seraient pas transmis, ils sont donc désactivés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルは外部 CLI 上で動作し、独自のハーネスを持っています。ここで設定したプロンプトとスキルは反映されないため無効化されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该档案跑在外部 CLI 上，人家自带 harness。这里配的提示词与技能包送不进去，因此禁用。"
          }
        }
      }
    },
