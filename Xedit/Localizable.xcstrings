    "settings.voice.auto-unload-note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model also auto-unloads after 5 minutes of foreground idle, 10 minutes of background, or when the app's resident memory exceeds 4 GB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo también se descarga automáticamente tras 5 minutos de inactividad en primer plano, 10 minutos en segundo plano, o cuando la memoria residente de la app supera los 4 GB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle se décharge aussi automatiquement après 5 minutes d'inactivité au premier plan, 10 minutes en arrière-plan, ou lorsque la mémoire résidente de l'application dépasse 4 Go."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルは、フォアグラウンドで5分間、バックグラウンドで10分間アイドル状態が続いた場合、またはアプリの常駐メモリが4GBを超えた場合にも自動的にアンロードされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型还会在前台空闲 5 分钟、后台 10 分钟,或应用常驻内存超过 4 GB 时自动卸载。"
          }
        }
      }
    },
