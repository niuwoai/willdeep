    },
    "After your first transcription, warm the ~937 MB model on each app start so push-to-talk responds instantly. Disable to save memory at the cost of a 1-5 s cold start." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次转写后,每次启动应用时预热约 937 MB 的模型,让按住说话即刻响应。关闭可节省内存,但代价是 1-5 秒的冷启动。"
          }
        }
      }
    },
    "Agent" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
