    "settings.remote-runtimes.daemon-description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Connects to willdeep-agent over HTTP/WebSocket. Keep the daemon bound to 127.0.0.1 and reach it through an SSH tunnel; WillDeep stores the token in Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conecta a willdeep-agent mediante HTTP/WebSocket. Mantén el daemon vinculado a 127.0.0.1 y accede a él mediante un túnel SSH; WillDeep guarda el token en Keychain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte à willdeep-agent via HTTP/WebSocket. Gardez le daemon lié à 127.0.0.1 et accédez-y via un tunnel SSH ; WillDeep stocke le token dans le Trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP/WebSocket 経由で willdeep-agent に接続します。daemon は 127.0.0.1 にバインドし、SSH トンネル経由でアクセスしてください。WillDeep は token を Keychain に保存します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 HTTP/WebSocket 连接到 willdeep-agent。请将 daemon 绑定在 127.0.0.1 上，并通过 SSH 隧道访问；WillDeep 会把 token 存入 Keychain。"
          }
        }
      }
    },
