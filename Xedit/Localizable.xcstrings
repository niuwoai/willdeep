    "The agent can read files, search, list directories, run commands (with approval), and check Git status." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente puede leer archivos, buscar, listar directorios, ejecutar comandos (con aprobación) y comprobar el estado de Git."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Agent peut lire des fichiers, effectuer des recherches, lister des répertoires, exécuter des commandes (avec approbation) et vérifier l'état Git."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent はファイルの読み取り、検索、ディレクトリの一覧表示、コマンドの実行（承認が必要）、Git ステータスの確認ができます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 可以读取文件、搜索、列出目录、运行命令（需批准）以及查看 Git 状态。"
          }
        }
      }
    },
    "The model also auto-unloads after 5 minutes of foreground idle, 10 minutes of background, or when the app's resident memory exceeds 4 GB." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo también se descarga automáticamente tras 5 minutos inactivo en primer plano, 10 minutos en segundo plano, o cuando la memoria residente de la app supera 4 GB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle se décharge aussi automatiquement après 5 minutes d'inactivité au premier plan, 10 minutes en arrière-plan, ou lorsque la mémoire résidente de l'application dépasse 4 GB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォアグラウンドで5分間、バックグラウンドで10分間アイドル状態が続いた場合、またはアプリの常駐メモリが4 GBを超えた場合にも、モデルは自動的にアンロードされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前台空闲 5 分钟、后台 10 分钟，或应用常驻内存超过 4 GB 时，模型还会自动卸载。"
          }
        }
      }
    },
