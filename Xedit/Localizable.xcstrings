    "app-termination.active-task.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quitting now may interrupt active work and stop progress updates. Do you still want to quit WillDeep?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Salir ahora puede interrumpir el trabajo activo y detener las actualizaciones de progreso. ¿Aún quieres salir de WillDeep?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Quitter maintenant risque d'interrompre le travail en cours et d'arrêter les mises à jour de progression. Voulez-vous tout de même quitter WillDeep ?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "今終了すると、進行中の作業が中断され、進捗の更新が停止する可能性があります。それでも WillDeep を終了しますか？" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在退出可能会中断正在进行的工作，并停止更新任务进度。仍要退出 WillDeep 吗？" } } } },
    "app-termination.active-task.quit-anyway" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit Anyway" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Salir de todos modos" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Quitter quand même" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このまま終了" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仍要退出" } } } },
