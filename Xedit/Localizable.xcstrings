    "settings.mobile-gateway.listen-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gateway listens only after you enable it. Android connects over the local network; Agent execution, tools, patches, and file access still run through the Mac app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gateway solo escucha una vez que lo activas. Android se conecta a través de la red local; la ejecución del Agent, las herramientas, los parches y el acceso a archivos siguen pasando por la app de Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passerelle n'écoute qu'une fois activée. Android se connecte via le réseau local ; l'exécution de l'Agent, les outils, les correctifs et l'accès aux fichiers passent toujours par l'application Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイは有効化した後のみリッスンします。Android はローカルネットワーク経由で接続します。Agent の実行、ツール、パッチ、ファイルアクセスは引き続きすべて Mac アプリを経由します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有启用后网关才会监听。Android 通过局域网连接；Agent 执行、工具、补丁和文件访问仍全部经过 Mac 应用。"
          }
        }
      }
    },
