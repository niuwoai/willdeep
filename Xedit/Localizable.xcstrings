          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le CLI officiel de Feishu/Lark pour la configuration locale de l'application, la connexion OAuth et les opérations actives sur les documents/messages/calendrier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feishu/Larkの公式CLIを使用して、ローカルアプリのセットアップ、OAuthログイン、およびドキュメント/メッセージ/カレンダーの能動的な操作を行います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用飞书/Lark 官方 CLI 来完成本地应用配置、OAuth 登录，以及主动的文档/消息/日历操作。"
          }
        }
      }
    },
