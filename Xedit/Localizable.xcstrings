    "agent-model-picker.coding-plan-benefit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A some.im package for frequent coding tasks, with packaged usage and more predictable cost." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Un paquete de some.im para tareas de programación frecuentes, con uso incluido y un costo más previsible." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un forfait some.im pour les tâches de codage fréquentes, avec une utilisation groupée et un coût plus prévisible." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "頻繁なコーディング作業向けの some.im プランです。使用量がパッケージ化され、コストの見通しが立てやすくなります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "some.im 为高频编程任务提供的套餐包，让用量打包、成本更可预期。" } } } },
