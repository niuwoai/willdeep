    "editor-terminal.environment-footnote" : {
      "comment" : "Footnote under the environment editor explaining the KEY=value format",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One KEY=value per line. Values are shared by the editor terminal and local Agent commands; $VAR references expand in order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una variable KEY=value por línea. Los valores se comparten entre el terminal del editor y los comandos locales del Agent; las referencias $VAR se expanden en orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une paire CLÉ=valeur par ligne. Les valeurs sont partagées par le terminal de l'éditeur et les commandes Agent locales ; les références $VAR sont développées dans l'ordre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 行につき 1 つの KEY=value。この値はエディタターミナルとローカルの Agent コマンドで共有され、$VAR 参照は順番に展開されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行一个 KEY=value。编辑器终端和本地 Agent 命令共用这些值；$VAR 会按行顺序展开。"
          }
        }
      }
    },
