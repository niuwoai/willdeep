    "settings.connectors.lark-cli.help" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Official lark-cli is the recommended local bridge for active Feishu operations. It stores credentials in the OS keychain and lets WillDeep call Feishu with structured commands instead of raw shell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lark-cli oficial es el puente local recomendado para operaciones activas de Feishu. Guarda las credenciales en el llavero del sistema operativo y permite que WillDeep llame a Feishu con comandos estructurados en lugar de shell sin procesar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lark-cli officiel est le pont local recommandé pour les opérations actives Feishu. Il stocke les identifiants dans le trousseau du système et permet à WillDeep d'appeler Feishu avec des commandes structurées plutôt qu'en shell brut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公式lark-cliは、Feishuに対する能動的な操作のための推奨ローカルブリッジです。認証情報をOSのキーチェーンに保存し、WillDeepが生のshellではなく構造化されたコマンドでFeishuを呼び出せるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "官方 lark-cli 是进行飞书主动操作的推荐本地桥接。它会把凭据存放在系统钥匙串中，让 WillDeep 通过结构化命令调用飞书，而不必使用原始 shell。"
          }
        }
      }
    },
