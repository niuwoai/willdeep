        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir el sistema es lo predeterminado. Elige japonés u otro idioma fijo cuando necesites pruebas deterministas de entrada de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
