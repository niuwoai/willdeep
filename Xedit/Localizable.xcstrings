    "settings.connectors.authorization-url-help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave empty to only prepare the callback and Keychain reference. When filled, WillDeep appends standard OAuth query parameters unless placeholders are present."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para preparar solo la devolución de llamada y la referencia del llavero. Al rellenarlo, WillDeep añade los parámetros de consulta OAuth estándar salvo que haya marcadores de posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour ne préparer que le rappel et la référence du trousseau. Une fois rempli, WillDeep ajoute les paramètres de requête OAuth standards, sauf si des espaces réservés sont présents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄のままにすると、コールバックとKeychain参照のみが準備されます。入力すると、プレースホルダーがない限りWillDeepが標準のOAuthクエリパラメータを追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空时只准备回调和 Keychain 引用。填写后，如无占位符，WillDeep 会追加标准 OAuth 查询参数。"
          }
        }
      }
    },
