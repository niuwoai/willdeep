    "agent-model-picker.no-results" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No matching models" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay modelos coincidentes" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun modèle correspondant" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "該当するモデルがありません" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有找到匹配的模型" } } } },
    "agent-model-picker.note.complex-coding" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Complex refactors, multi-file reasoning, and difficult debugging" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Refactorizaciones complejas, razonamiento multiarchivo y depuración difícil" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Refactorisations complexes, raisonnement multi-fichiers et débogage difficile" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "複雑なリファクタリング、複数ファイルにまたがる推論、難しいデバッグに" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复杂重构、多文件推理和疑难调试" } } } },
