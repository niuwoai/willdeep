    "sidebar.delete-session.alert-message" : {
      "comment" : "confirmation alert body; %@ is the session title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and all its messages will be permanently deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y todos sus mensajes se eliminarán de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et tous ses messages seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とそのすべてのメッセージは完全に削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」及其全部消息将被永久删除，无法撤销。"
          }
        }
      }
    },
