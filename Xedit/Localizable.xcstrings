    "dispatch.workspace-mapping-help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only map checkouts of the same project." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo se pueden asignar copias del mismo proyecto." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Associez uniquement des checkouts du même projet." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "同じプロジェクトのチェックアウトのみマッピングできます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只能映射同一个项目的工作目录。" } } } },
    "dispatch.workspace-mapping-required" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Map a workspace for this execution environment before launching the task." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Asigna un espacio de trabajo para este entorno de ejecución antes de iniciar la tarea." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Associez un espace de travail à cet environnement d'exécution avant de lancer la tâche." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "タスクを開始する前に、この実行環境用のワークスペースをマッピングしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先为这个执行环境映射工作区，再启动任务。" } } } },
