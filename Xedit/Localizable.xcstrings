    "settings.replicate.clear" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Borrar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Effacer" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "クリア" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除" } } } },
    "settings.replicate.configured" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replicate is configured" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Replicate está configurado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Replicate est configuré" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Replicate は設定済みです" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Replicate 已配置" } } } },
    "settings.replicate.env-configured" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Configured via the REPLICATE_API_TOKEN environment variable" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Configurado mediante la variable de entorno REPLICATE_API_TOKEN" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Configuré via la variable d'environnement REPLICATE_API_TOKEN" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "REPLICATE_API_TOKEN 環境変数で設定済み" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已通过 REPLICATE_API_TOKEN 环境变量配置" } } } },
    "settings.replicate.erase" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Image erase" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Borrado de imagen" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Effacement d'image" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像消去" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "图片擦除" } } } },
    "settings.replicate.inpaint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mask inpaint" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Repintado con máscara" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retouche par masque" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マスクインペイント" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "蒙版重绘" } } } },
    "settings.replicate.not-configured" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replicate is not configured" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Replicate no está configurado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Replicate n'est pas configuré" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Replicate は未設定です" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Replicate 未配置" } } } },
    "settings.replicate.token-description" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Used for Replicate image upscale, erase, inpaint, and video/image prediction tasks. The token is stored in Keychain and never written to chats, logs, or commits." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se usa para las tareas de Replicate de aumento de resolución, borrado, repintado con máscara y predicción de vídeo/imagen. El token se guarda en Keychain y nunca se escribe en chats, registros ni commits." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilisé pour l'agrandissement, l'effacement, la retouche par masque et les tâches de prédiction vidéo/image de Replicate. Le token est stocké dans le trousseau ; il n'est jamais écrit dans les discussions, les journaux ou les commits." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Replicate の画像アップスケール、消去、インペイント、動画/画像予測タスクに使用します。トークンは Keychain に保存され、チャットやログ、コミットに書き込まれることはありません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于 Replicate 图片放大、擦除、蒙版重绘和视频/图片预测任务。Token 存入 Keychain；不会写入聊天、日志或提交内容。" } } } },
    "settings.replicate.upscale" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Image upscale" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aumento de resolución de imagen" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Agrandissement d'image" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像アップスケール" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "图片放大" } } } },
    "settings.replicate.version-placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replicate version hash" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Hash de versión de Replicate" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hachage de version Replicate" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Replicate version hash" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Replicate version hash" } } } },
    "settings.replicate.workflow-description" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With common model version hashes filled in, media-task thumbnails can start an upscale directly, and the image edit panel reuses the default inpaint version." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Con los hashes de versión de modelo habituales rellenados, las miniaturas de tareas multimedia pueden iniciar un aumento de resolución directamente, y el panel de edición de imágenes reutiliza la versión de repintado predeterminada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une fois les hachages de version de modèles Replicate courants renseignés, les vignettes des tâches multimédias peuvent lancer un agrandissement directement, et le panneau d'édition d'image réutilise la version de retouche par défaut." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "よく使う Replicate model version hash を設定しておくと、メディアタスクのサムネイルから直接アップスケールを開始でき、画像編集パネルもデフォルトの inpaint version を再利用します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "填写常用 Replicate model version hash 后，媒体任务图片缩略图可直接发起放大；图片编辑面板也可复用蒙版重绘默认 version。" } } } },
    "settings.replicate.workflow-section" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default Workflow Versions" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Versiones de flujo de trabajo predeterminadas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Versions de workflow par défaut" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "デフォルトワークフローバージョン" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认 Workflow Versions" } } } },
