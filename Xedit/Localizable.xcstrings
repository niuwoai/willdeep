    "agent-delegation.profile-editor-purpose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit ONE approved file. Requires a `target_file` argument and the user's approval; cannot touch any other path." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只编辑一个已批准的文件。必须带 `target_file` 参数并经用户批准；不能碰任何其他路径。" } } } },
