    "sidebar.session-unavailable.alert-message" : {
      "comment" : "Alert body shown when a sidebar session metadata row no longer has a readable history file; %@ is the session title",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” could not be opened because its local history file is missing. WillDeep kept the sidebar entry so you can restore the file from backup. No new data was written over it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir «%@» porque falta su archivo de historial local. WillDeep ha conservado la entrada en la barra lateral para que puedas restaurarla desde una copia de seguridad. No se ha escrito ningún dato nuevo sobre ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'a pas pu être ouvert car son fichier d'historique local est manquant. WillDeep a conservé l'entrée dans la barre latérale pour que vous puissiez restaurer le fichier depuis une sauvegarde. Aucune nouvelle donnée n'a été écrite par-dessus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はローカルの履歴ファイルが見つからないため開けませんでした。バックアップから復元できるよう、WillDeep はサイドバーの項目を残しています。新しいデータで上書きされることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的本地历史文件缺失。WillDeep 已保留侧边栏条目，便于你从备份恢复；不会用空会话覆盖原文件。"
          }
        }
      }
    },
