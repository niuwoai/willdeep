    "tool-card.authorization.sandbox-escalation.decision-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this when the sandbox denial is blocking routine work the Agent will retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa esto cuando la denegación del sandbox esté bloqueando trabajo rutinario que el Agente volverá a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À utiliser lorsque le refus du bac à sable bloque un travail courant que l'Agent va retenter."
          }
        },
