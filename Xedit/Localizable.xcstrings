    "secret-manager.delete-message" : {
      "comment" : "Warns that deleting breaks existing placeholders",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be removed from the Keychain. Placeholders already inserted into past conversations will stop resolving. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se eliminará del llavero. Los marcadores de posición ya insertados en conversaciones pasadas dejarán de resolverse. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé du trousseau. Les espaces réservés déjà insérés dans les conversations passées cesseront de se résoudre. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はKeychainから削除されます。過去の会話に挿入済みのプレースホルダーは解決できなくなります。この操作は元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从钥匙串中移除。历史会话里已插入的占位符将无法再解析。此操作不可撤销。"
          }
        }
      }
    },
