    "tool-card.authorization.sandbox-escalation.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep can re-run the same command outside the sandbox if you approve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep puede volver a ejecutar el mismo comando fuera del sandbox si lo apruebas."
