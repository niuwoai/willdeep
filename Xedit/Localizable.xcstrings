    "settings.connectors.dingtalk-mcp.help" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DingTalk does not currently expose a lark-cli-style official CLI. Use the official DingTalk MCP server as the preferred local tool bridge; event intake can still use Stream SDK or relay callbacks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DingTalk actualmente no ofrece un CLI oficial al estilo de lark-cli. Usa el servidor MCP oficial de DingTalk como puente preferido de herramientas locales; la recepción de eventos aún puede usar Stream SDK o devoluciones de llamada de retransmisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DingTalk n'expose actuellement pas de CLI officiel de type lark-cli. Utilisez le serveur MCP officiel DingTalk comme pont d'outils local privilégié ; la réception d'événements peut toujours passer par le Stream SDK ou des rappels relais."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DingTalkは現在、lark-cliのような公式CLIを提供していません。ローカルツールブリッジとしては公式のDingTalk MCPサーバーの使用を推奨します。イベントの受信には引き続きStream SDKまたはリレーコールバックを使用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钉钉目前没有提供 lark-cli 那样的官方 CLI。建议使用钉钉官方 MCP 服务器作为首选的本地工具桥接；事件接入仍可使用 Stream SDK 或回调中继。"
          }
        }
      }
    },
    "settings.connectors.dingtalk-mcp.install-hint" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses stdio: npx -y dingtalk-mcp@latest. Fill DINGTALK_Client_ID and DINGTALK_Client_Secret from the DingTalk developer console; keep secrets out of git."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa stdio: npx -y dingtalk-mcp@latest. Rellena DINGTALK_Client_ID y DINGTALK_Client_Secret desde la consola de desarrolladores de DingTalk; mantén los secretos fuera de git."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise stdio : npx -y dingtalk-mcp@latest. Renseignez DINGTALK_Client_ID et DINGTALK_Client_Secret depuis la console développeur DingTalk ; ne mettez pas les secrets dans git."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "stdioを使用します：npx -y dingtalk-mcp@latest。DingTalk開発者コンソールからDINGTALK_Client_IDとDINGTALK_Client_Secretを入力してください。シークレットはgitに含めないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 stdio：npx -y dingtalk-mcp@latest。请在钉钉开发者控制台填写 DINGTALK_Client_ID 和 DINGTALK_Client_Secret；请勿将密钥提交到 git。"
          }
        }
      }
    },
    "settings.connectors.dingtalk-mcp.reason" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DingTalk's practical official integration path is MCP for active tool calls, plus Stream SDK or relay callbacks for incoming events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vía de integración oficial práctica de DingTalk es MCP para llamadas activas a herramientas, más Stream SDK o devoluciones de llamada de retransmisión para eventos entrantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voie d'intégration officielle pratique de DingTalk est le MCP pour les appels d'outils actifs, complété par le Stream SDK ou des rappels relais pour les événements entrants."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DingTalkの実用的な公式統合経路は、能動的なツール呼び出しにはMCPを、受信イベントにはStream SDKまたはリレーコールバックを使用することです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钉钉切实可行的官方集成路径是：用 MCP 进行主动工具调用，再用 Stream SDK 或回调中继接收事件。"
          }
        }
      }
    },
