    "settings.image-understanding.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only when the active Agent provider cannot accept images directly. Multiple attached images are described in one request, then the description is sent to the main model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa solo cuando el proveedor de Agente activo no puede aceptar imágenes directamente. Varias imágenes adjuntas se describen en una sola solicitud, y luego la descripción se envía al modelo principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé uniquement lorsque le service Agent actif ne peut pas accepter les images directement. Plusieurs images jointes sont décrites en une seule requête, puis la description est envoyée au modèle principal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のAgentプロバイダーが画像を直接受け付けられない場合にのみ使用されます。複数の添付画像は1回のリクエストで説明文に変換され、その説明がメインモデルに送信されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当当前 Agent 服务商无法直接处理图片时启用。多张附件会在一次请求里被描述，然后把描述发给主模型。"
          }
        }
      }
    },
