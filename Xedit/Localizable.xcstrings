    "composer.stop.stopped" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The user stopped generation." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El usuario detuvo la generación." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'utilisateur a arrêté la génération." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ユーザーが生成を停止しました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用户已停止生成" } } } },
    "composer.stop.checking-processes" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped generating. Checking %lld process(es) started by this turn…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Generación detenida. Comprobando %lld proceso(s) iniciado(s) en este turno…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Génération arrêtée. Vérification de %lld processus lancé(s) par ce tour…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "生成を停止しました。このターンで開始した%lld個のプロセスを確認中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止继续生成，正在检查本轮启动的 %lld 个进程…" } } } },
    "composer.stop.cleaned-up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped generating and stopped %lld related task(s) or process(es) from this turn." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Generación detenida y se detuvieron %lld tarea(s) o proceso(s) relacionados de este turno." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Génération arrêtée et %lld tâche(s) ou processus lié(s) à ce tour ont été arrêtés." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "生成を停止し、このターンに関連する%lld個のタスクまたはプロセスも停止しました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止继续生成，本轮的 %lld 个相关任务或进程也已停止。" } } } },
    "composer.stop.processes-kept" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped generating. Current-turn processes were left running because they still need to continue." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Generación detenida. Los procesos del turno actual se dejaron en ejecución porque aún necesitan continuar." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Génération arrêtée. Les processus de ce tour ont été laissés en cours d'exécution, car ils doivent encore continuer." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "生成を停止しました。このターンのプロセスは継続が必要なため、実行したままにしています。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止继续生成；本轮进程仍需继续，未执行终止。" } } } },
    "composer.stop.processes-finished" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped generating. Related current-turn processes had already finished." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Generación detenida. Los procesos relacionados del turno actual ya habían terminado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Génération arrêtée. Les processus liés à ce tour étaient déjà terminés." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "生成を停止しました。このターンの関連プロセスはすでに終了しています。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止继续生成；本轮相关进程已自行结束。" } } } },
