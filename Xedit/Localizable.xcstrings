        "en": { "stringUnit": { "state": "translated", "value": "Used only when the active Agent provider cannot accept images directly. Multiple attached images are described in one request, then the description is sent to the main model." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "仅当当前 Agent 服务商无法直接处理图片时启用。多张附件会在一次请求里被描述，然后把描述发给主模型。" } }
      }
    },
