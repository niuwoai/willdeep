    "agent-model-picker.managed-not-selected-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation is using a specific model. Switch back when you want some.im to handle model selection." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前会话仍使用你选择的具体模型；需要自动选型时可切回省心托管。" } } } },
    "agent-model-picker.managed-not-selected-title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed Routing is not selected" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前没有选择省心托管" } } } },
    "agent-model-picker.managed-plan-independence" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed Routing works without Coding Plan. Coding Plan is a separate some.im package for coding usage." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "省心托管无需购买 Coding Plan；Coding Plan 只是 some.im 另行提供的编程套餐包。" } } } },
    "agent-model-picker.managed-rule" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "General tasks always use someim-auto-*; Coding Plan is used only for coding tasks" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通用任务始终使用 someim-auto-*；Coding Plan 仅用于编程任务" } } } },
    "agent-model-picker.managed-selected-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation uses a judge to choose and validate the working model automatically." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前会话会由裁判自动选择干活模型，并对执行结果进行校验。" } } } },
    "agent-model-picker.managed-selected-title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Managed Routing is selected" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前已选择省心托管" } } } },
    "agent-model-picker.managed-subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically select a model" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动选择模型" } } } },
    "agent-model-picker.managed-worker-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A cost-efficient model tries first. If it cannot finish or validation fails, Managed Routing escalates automatically." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先由低成本模型干活；实现不了或校验未通过时，再自动升档继续处理。" } } } },
