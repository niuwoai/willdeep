    "agent-delegation.profile-terminal-operator-purpose" : {
      "comment" : "User-facing description of the terminal-operator trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drives the visible side-panel terminal: runs given read-only commands in a tab, reads the screen, reports results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maneja el terminal visible del panel lateral: ejecuta comandos de solo lectura en una pestaña, lee la pantalla e informa resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilote le terminal visible du panneau latéral : exécute des commandes en lecture seule dans un onglet, lit l'écran et rapporte les résultats."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドパネルの可視ターミナルを操作：指定タブで読み取り専用コマンドを実行し、画面を読んで結果を報告する。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驾驶侧栏可见终端：在指定标签页执行只读命令、读屏并汇报结果。"
          }
        }
      }
    },
    "agent-delegation.profile-log-inspector-name" : {
      "comment" : "Display name of the log inspector subagent trade",
      "extractionState" : "manual",
      "localizations" : {
