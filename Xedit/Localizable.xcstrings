    "settings.voice.status-not-installed-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Download below (~937 MB). After install the mic button in composer goes live and the Fn-key push-to-talk shortcut starts working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en «Descargar» abajo (~937 MB). Tras la instalación, el botón de micrófono del compositor se activará y el atajo de pulsar Fn para hablar empezará a funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Télécharger ci-dessous (environ 937 Mo). Une fois installé, le bouton micro de la zone de saisie s'active et le raccourci Fn pour parler commence à fonctionner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の「ダウンロード」をクリックしてください（約937MB）。インストール後、コンポーザーのマイクボタンが有効になり、Fn キーによるプッシュトゥトークのショートカットも使えるようになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点下方「下载」(约 937 MB)。安装后输入框里的麦克风按钮即生效,Fn 键按住说话的快捷方式也会开始工作。"
          }
        }
      }
