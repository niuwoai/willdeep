    "settings.replicate.token-description" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Used for Replicate image upscale, erase, inpaint, and video/image prediction tasks. The token is stored in Keychain and never written to chats, logs, or commits." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于 Replicate 图片放大、擦除、蒙版重绘和视频/图片预测任务。Token 存入 Keychain；不会写入聊天、日志或提交内容。" } } } },
    "settings.replicate.upscale" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Image upscale" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "图片放大" } } } },
    "settings.replicate.version-placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replicate version hash" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Replicate version hash" } } } },
    "settings.replicate.workflow-description" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With common model version hashes filled in, media-task thumbnails can start an upscale directly, and the image edit panel reuses the default inpaint version." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "填写常用 Replicate model version hash 后，媒体任务图片缩略图可直接发起放大；图片编辑面板也可复用蒙版重绘默认 version。" } } } },
