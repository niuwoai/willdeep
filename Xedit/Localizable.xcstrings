    "agent-image-editor.mask-tool.brush-help" : {
      "comment" : "Help text for the brush mask tool",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint over the areas to erase or repaint. Switch between add and eraser to refine mask edges, then export a same-size PNG mask. White areas become the edit region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinta sobre las áreas a borrar o repintar. Alterna entre añadir y borrador para afinar los bordes de la máscara, luego exporta una máscara PNG del mismo tamaño. Las áreas blancas se convierten en la región de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peignez sur les zones à effacer ou à repeindre. Basculez entre ajout et gomme pour affiner les bords du masque, puis exportez un masque PNG de même taille. Les zones blanches deviennent la zone d'édition."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消去または再描画したい領域を塗りつぶします。追加/消しゴムを切り替えてマスクの境界を調整し、元画像と同じサイズの PNG マスクをエクスポートしてください。白い領域が編集対象になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动画笔涂抹要擦除或重绘的区域；可切换添加/橡皮修整蒙版边缘，再导出同尺寸 PNG 蒙版。白色区域会作为编辑区域。"
          }
        }
      }
    },
