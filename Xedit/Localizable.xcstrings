    "settings.remote-runtimes.ssh-description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses the system ssh client with BatchMode authentication. Configure hosts in your normal SSH config or provide an optional identity-file path; WillDeep stores only the path, never private key contents."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用系统的 ssh 客户端以 BatchMode 方式认证。请在常规 SSH 配置中设置主机，或提供一个可选的身份文件路径；WillDeep 只存储该路径，绝不会存储私钥内容。"
          }
        }
      }
    },
