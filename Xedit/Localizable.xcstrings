    "settings.some-im.browser-login-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep prepares a secure some.im sign-in request automatically. Open it in your browser, sign in, then return to WillDeep when some.im says you can continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep prepara automáticamente una solicitud de inicio de sesión segura de some.im. Ábrela en tu navegador, inicia sesión y vuelve a WillDeep cuando some.im indique que puedes continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep prépare automatiquement une requête de connexion sécurisée à some.im. Ouvrez-la dans votre navigateur, connectez-vous, puis revenez à WillDeep lorsque some.im indique que vous pouvez continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep が安全な some.im サインインリクエストを自動的に準備します。ブラウザで開いてサインインし、some.im が続行可能と表示したら WillDeep に戻ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WillDeep 会自动准备安全的 some.im 登录请求。请在浏览器里打开 some.im 并完成登录，页面提示可继续后回到 WillDeep 使用。"
          }
        }
      }
    },
