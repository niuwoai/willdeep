    "dispatch.remote-workspace-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the directory where %@ is checked out on %@. This maps an execution checkout; it does not change the project." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Introduce el directorio donde %@ está descargado en %@. Esto asigna una copia de ejecución; no cambia el proyecto." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Indiquez le répertoire où %@ est extrait sur %@. Ceci associe un checkout d'exécution ; cela ne modifie pas le projet." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ が %@ 上でチェックアウトされているディレクトリを入力してください。これは実行用チェックアウトのマッピングのみで、プロジェクトそのものは変更しません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入项目 %@ 在 %@ 上对应的检出目录。这里只映射执行工作区，不会改变项目归属。" } } } },
