    "dispatch.delete-goal-confirmation-message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” has received project instructions. Deleting it will stop its current work and remove its task conversations. This cannot be undone." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "“%@” ya ha recibido instrucciones del proyecto. Eliminarlo detendrá el trabajo actual y eliminará sus conversaciones de tareas. Esto no se puede deshacer." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "« %@ » a reçu des instructions de projet. Le supprimer arrêtera son travail en cours et supprimera ses conversations de tâches. Cette action est irréversible." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」はすでにプロジェクト指示を受け取っています。削除すると現在の作業が停止し、タスクの会話も削除されます。この操作は元に戻せません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“%@” 已经收到过项目指令。删除会停止正在进行的工作并移除其任务会话，且无法撤销。" } } } },
