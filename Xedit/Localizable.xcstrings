    "agent-model-picker.managed-judge-description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A judge identifies the task and difficulty, chooses the working model, and validates the result." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "裁判负责判断任务类型和难度、选择干活模型，并对结果进行质量校验。" } } } },
