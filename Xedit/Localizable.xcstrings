    "settings.some-im.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stores your some.im key in Keychain and lets WillDeep route image/video generation to the relay instead of guessing whether the active chat model supports generation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu clave de some.im en Keychain y permite que WillDeep enrute la generación de imágenes/vídeo al relay en lugar de adivinar si el modelo de chat activo admite generación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stocke votre clé some.im dans le trousseau et permet à WillDeep d'envoyer la génération d'images/vidéos au relais, au lieu de deviner si le modèle de chat actif prend en charge la génération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "some.im の key を Keychain に保存し、現在のチャットモデルが生成に対応しているかを推測する代わりに、WillDeep が画像/動画生成を relay へルーティングできるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "some.im key 会存入 Keychain；WillDeep 会把图片/视频生成路由到 relay，而不是猜当前聊天模型是否支持生成。"
          }
        }
      }
    },
