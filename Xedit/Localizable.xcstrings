            "value" : "Ops Runner"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operador de consultas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuteur d'exploitation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運用ランナー"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运维查询员"
          }
        }
      }
    },
    "agent-delegation.profile-ops-runner-purpose" : {
      "comment" : "User-facing description of the ops-runner trade",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only operations queries via shell: service status, log tails, kubectl/gh inspection. Can inspect, never change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultas de operaciones de solo lectura por shell: estado de servicios, colas de logs, inspección de kubectl/gh. Puede inspeccionar, nunca cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requêtes d'exploitation en lecture seule via le shell : état des services, fins de journaux, inspection kubectl/gh. Peut inspecter, jamais modifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル経由の読み取り専用の運用クエリ：サービス状態、ログ末尾、kubectl/gh の確認。調査はできるが変更は一切しない。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读运维查询：服务状态、日志尾部、kubectl/gh 检视。只看不改。"
          }
        }
      }
    },
    "agent-delegation.profile-terminal-operator-name" : {
