    "settings.voice.preload-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the ~937 MB voice model out of memory at launch by default. Enable this after your first transcription if you prefer instant push-to-talk over lower idle memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada, el modelo de voz (~937 MB) no se carga en memoria al iniciar. Activa esta opción después de tu primera transcripción si prefieres una respuesta instantánea al pulsar para hablar en lugar de un menor uso de memoria en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, le modèle vocal d'environ 937 Mo n'est pas chargé en mémoire au lancement. Activez cette option après votre première transcription si vous préférez une réponse instantanée au bouton Parler plutôt qu'une mémoire au repos plus faible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは起動時に約937MBの音声モデルをメモリに読み込みません。低アイドルメモリよりも即座のプッシュトゥトークを優先する場合は、最初の文字起こしの後にこれを有効にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认启动时不把约 937 MB 的语音模型放进内存。首次转写后,如果你更想要按住说话即刻响应,可打开此项。"
          }
        }
      }
    },
    "settings.voice.preload-toggle" : {
      "extractionState" : "manual",
      "localizations" : {
