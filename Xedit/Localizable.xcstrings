    "settings.agent-wallpaper.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the workspace wallpaper selected above throughout the Agent workspace. Adjust the interface surface opacity and optional frosted glass for readability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el fondo de pantalla del espacio de trabajo seleccionado arriba en todo el espacio de trabajo del Agente. Ajusta la opacidad de la superficie de la interfaz y el cristal esmerilado opcional para mejorar la legibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le fond d'écran de l'espace de travail sélectionné ci-dessus dans tout l'espace de travail Agent. Ajustez l'opacité de la surface d'interface et le verre dépoli optionnel pour la lisibilité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上で選択したワークスペース壁紙をAgentワークスペース全体で使用します。読みやすさのために、インターフェース表面の不透明度と、任意でフロストガラス効果を調整できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 工作区使用上方选择的工作区壁纸；可调整界面遮罩透明度，并按需启用毛玻璃以保持内容清晰。"
          }
        }
      }
    },
