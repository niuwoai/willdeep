    "automation.template.daily-brief.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generate a morning brief for the current project: inspect git status, recent changes, TODO clues, and risks that need attention today. Return prioritized action items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera un resumen matutino del proyecto actual: revisa el estado de git, los cambios recientes, las pistas TODO y los riesgos que requieren atención hoy. Devuelve elementos de acción priorizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez un brief matinal pour le projet actuel : examinez l'état git, les modifications récentes, les indices TODO et les risques nécessitant une attention aujourd'hui. Renvoyez des actions classées par priorité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のプロジェクトの朝のブリーフィングを作成してください。git のステータス、最近の変更、TODO の手がかり、今日注意すべきリスクを確認し、優先順位付けされたアクション項目を返してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请生成一份当前项目的晨间简报：检查 git 状态、最近变更、TODO 线索和今天需要关注的风险，并输出按优先级排序的行动项。"
          }
        }
      }
    },
    "automation.template.project-monitor.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project Monitor"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor de proyecto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillance du projet"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトモニター"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目监控"
          }
        }
      }
    },
    "automation.template.project-monitor.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspect the current project for obvious risks: uncommitted changes, TODO/FIXME markers, recently edited key files, and anything that may need my attention. Summarize findings and next actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspecciona el proyecto actual en busca de riesgos evidentes: cambios sin confirmar, marcadores TODO/FIXME, archivos clave editados recientemente y cualquier cosa que pueda requerir mi atención. Resume los hallazgos y las próximas acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinez le projet actuel à la recherche de risques évidents : modifications non validées, marqueurs TODO/FIXME, fichiers clés récemment modifiés, et tout ce qui pourrait nécessiter mon attention. Résumez les constats et les prochaines actions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のプロジェクトに明らかなリスクがないか確認してください：未コミットの変更、TODO/FIXME マーカー、最近編集された主要ファイル、その他注意が必要な事項です。発見内容と次のアクションをまとめてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查当前项目是否存在明显风险：未提交变更、TODO/FIXME 标记、最近修改的关键文件，以及任何可能需要我注意的事项。请汇总发现和下一步行动。"
          }
        }
      }
    },
    "automation.template.weekly-review.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekly Review"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisión semanal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilan hebdomadaire"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週次レビュー"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周回顾"
          }
        }
      }
