    "settings.remote-runtimes.ssh-description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses the system ssh client with BatchMode authentication. Configure hosts in your normal SSH config or provide an optional identity-file path; WillDeep stores only the path, never private key contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el cliente ssh del sistema con autenticación BatchMode. Configura los hosts en tu configuración SSH habitual o proporciona una ruta opcional al archivo de identidad; WillDeep solo guarda la ruta, nunca el contenido de la clave privada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le client ssh du système avec authentification en BatchMode. Configurez les hôtes dans votre configuration SSH habituelle ou indiquez un chemin de fichier d'identité optionnel ; WillDeep ne stocke que ce chemin, jamais le contenu de la clé privée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの ssh クライアントを BatchMode 認証で使用します。通常の SSH 設定でホストを構成するか、任意で識別ファイルのパスを指定してください。WillDeep はパスのみを保存し、秘密鍵の内容は保存しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用系统的 ssh 客户端以 BatchMode 方式认证。请在常规 SSH 配置中设置主机，或提供一个可选的身份文件路径；WillDeep 只存储该路径，绝不会存储私钥内容。"
          }
        }
      }
    },
