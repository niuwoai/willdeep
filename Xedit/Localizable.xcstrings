        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会話をディスクに保存できませんでした。終了後、最近のメッセージが失われる可能性があります。空き容量とフォルダの権限を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
