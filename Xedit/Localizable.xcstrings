    "settings.connectors.auth.webhook-help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-way robot messages and simple slash-like workflows. Fast to set up, limited user context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensajes de robot unidireccionales y flujos sencillos tipo comando de barra. Rápido de configurar, contexto de usuario limitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages de robot à sens unique et flux simples de type commande slash. Configuration rapide, contexte utilisateur limité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一方向のボットメッセージと、シンプルなスラッシュコマンド風のワークフロー向けです。設定は速いですが、ユーザーコンテキストは限定的です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于单向机器人消息和简单指令，配置快，但用户上下文有限。"
