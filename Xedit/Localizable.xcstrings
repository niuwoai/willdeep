    "settings.web-tools.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enables the built-in web_search tool. Auto tries local Exa first, then Brave; if both keys are empty and some.im is signed in, it uses some.im managed search. API keys are stored in the macOS Keychain. web_fetch needs no key and asks for approval per domain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于启用内置 web_search 搜索工具。自动模式优先使用本地 Exa，然后回退到 Brave；如果两个密钥都为空且已登录 some.im，则使用 some.im 托管搜索。密钥保存在 macOS 钥匙串中。web_fetch 抓取网页无需密钥，按域名逐次授权。"
          }
        }
      }
    },
