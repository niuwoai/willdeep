          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate prefers the version entered here; when empty, the mask-inpaint version from Settings → Integrations → Replicate is used. The model must accept image, mask, and prompt inputs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate 会优先使用这里填写的 version；留空时使用 Settings → Integrations → Replicate 的蒙版重绘 version。该模型需支持 image、mask、prompt 输入。"
