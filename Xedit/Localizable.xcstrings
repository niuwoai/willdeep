    "agent-model-picker.coding-plan-unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The package service is temporarily unavailable. Your existing subscription has not been changed." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El servicio de paquetes no está disponible por ahora. Tu suscripción existente no ha cambiado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le service de forfaits est temporairement indisponible. Votre abonnement existant n'a pas été modifié." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プランサービスが一時的に利用できません。既存のサブスクリプションは変更されていません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "套餐服务暂时不可用；这不代表你没有订阅，也不会改变现有套餐。" } } } },
