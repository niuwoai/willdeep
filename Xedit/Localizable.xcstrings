    "agent-image-editor.replicate.help-erase" : {
      "comment" : "Footnote for the Replicate provider in erase mode",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate prefers the version entered here; when empty, the image-erase version from Settings → Integrations → Replicate is used. Erase can run without a prompt — a basic background-repair prompt is added automatically on submit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replicate 会优先使用这里填写的 version；留空时使用 Settings → Integrations → Replicate 的图片擦除 version。擦除可不填提示词，提交时会自动补一个基础背景修复提示。"
          }
        }
      }
    },
