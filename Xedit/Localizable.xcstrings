    "agent-project.last-folder-hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A project keeps at least one folder. Removing the last one removes the project." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Un proyecto conserva al menos una carpeta. Eliminar la última equivale a eliminar el proyecto." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un projet conserve au moins un dossier. Supprimer le dernier supprime le projet." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロジェクトには少なくとも1つのフォルダが必要です。最後の1つを削除するとプロジェクトも削除されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "项目至少保留一个文件夹；移除最后一个等同于删除该项目。" } } } },
