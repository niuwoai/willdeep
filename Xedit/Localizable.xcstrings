    "secret-manager.rename-message" : {
      "comment" : "Explains that renaming keeps the placeholder identifier",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the display name changes. The placeholder stays %@, so secrets already inserted into past conversations keep working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia el nombre mostrado. El marcador de posición sigue siendo %@, así que los secretos ya insertados en conversaciones pasadas siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le nom affiché change. L'espace réservé reste %@, les secrets déjà insérés dans les conversations passées continuent donc de fonctionner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更されるのは表示名だけです。プレースホルダーは %@ のまま保たれるため、過去の会話に挿入済みのシークレットも引き続き機能します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只改展示名称。占位符仍是 %@，历史会话里已插入的密钥照常可用。"
          }
        }
      }
    },
