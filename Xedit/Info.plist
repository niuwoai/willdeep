<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>WillDeep</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Text Documents</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.text</string>
				<string>public.plain-text</string>
				<string>public.source-code</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folders</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleHelpBookFolder</key>
	<string>WillDeep.help</string>
	<key>CFBundleHelpBookName</key>
	<string>WillDeep Help</string>
	<key>CFBundleName</key>
	<string>WillDeep</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>WillDeep OAuth Callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>willdeep</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>WillDeep uses your microphone to power voice-driven workflows: dictating prompts to the agent, recording meeting notes, and transcribing live audio on-device (no cloud upload).</string>
	<key>WillDeepSomeIMClientLoginSecret</key>
	<string>$(WILLDEEP_CLIENT_LOGIN_SECRET)</string>
</dict>
</plist>
