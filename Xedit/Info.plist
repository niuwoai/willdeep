<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<!-- Sparkle's default is 24h, which is why automatic installs almost never
	     won the race: the app's own 17-minute update poller surfaced the banner
	     first and users took the manual path. Hourly gives the automatic path a
	     real chance without polling the appcast aggressively. -->
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<key>SUFeedURL</key>
	<string>https://some.im/api/v1/public/app-updates/appcast.xml?app_id=willdeep&amp;platform=macos&amp;channel=stable</string>
	<key>SUPublicEDKey</key>
	<string>3QVMPCYo42ORmq8uUHqUdW8ayy5nw8Hs5uq9DLKDp0A=</string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>WillDeep</string>
	<key>CFBundleHelpBookFolder</key>
	<string>WillDeep.help</string>
	<key>CFBundleHelpBookName</key>
	<string>WillDeep Help</string>
	<key>CFBundleName</key>
	<string>WillDeep</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>WillDeep OAuth Callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>willdeep</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
