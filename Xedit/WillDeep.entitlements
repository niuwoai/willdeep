<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: disable library validation so the bundled
	     ONNX Runtime dylib (signed by Microsoft, then re-signed locally
	     during development) can be loaded without Team ID matching the
	     host process's certificate. Required for /transcribe to work
	     in release builds. Notarization accepts this entitlement; the
	     tradeoff is that any dylib placed inside the app bundle will
	     load — we accept that since we already ship ONNX as a trusted
	     third-party binary. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Shared Keychain access group for cross-app some.im login state.
	     $(AppIdentifierPrefix) expands to the Team ID prefix "ZH2S7D6PL6.".
	     Every app that shares the login (museterm, etc.) must be signed with
	     Team ZH2S7D6PL6 and carry this exact same group. Consumed by the
	     SomeIMSharedSession package via
	       SomeIMSharedSessionStore.shared.configure(accessGroup: "ZH2S7D6PL6.com.someim.shared"). -->
	<key>keychain-access-groups</key>
	<array>
		<!-- App-owned Data Protection Keychain namespace. Keeping ordinary
		     Agent credentials here avoids the legacy per-binary ACL dialog
		     after WillDeep updates; macOS login / Touch ID unlock governs it. -->
		<string>$(AppIdentifierPrefix)com.willdeep.app</string>
		<string>$(AppIdentifierPrefix)com.someim.shared</string>
	</array>

	<!-- App Sandbox is OFF (default for this project). If sandbox ever
	     gets enabled, also add:
	       com.apple.security.app-sandbox = true
	       com.apple.security.files.user-selected.read-only = true
	     so the agent can still read user-picked audio files via the
	     panel-driven path. -->
</dict>
</plist>
