{
  "sourceLanguage": "en",
  "strings": {
    "section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project archiving"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目归档"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivado de proyectos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivage des projets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトのアーカイブ"
          }
        }
      }
    },
    "enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically archive projects inactive for over 30 days"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动归档超过 30 天未活跃的项目"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivar proyectos inactivos durante más de 30 días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiver les projets inactifs depuis plus de 30 jours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30 日を超えて利用していないプロジェクトを自動アーカイブ"
          }
        }
      }
    },
    "description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived projects are hidden from the sidebar. Files and conversations are kept. Restore them below. Open, pinned, running, awaiting-attention, and draft projects are protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档项目会从侧栏收起，保留文件和会话，可在下方恢复。已打开、置顶、正在运行、有待处理事项或草稿的项目不会自动归档。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos archivados se ocultan en la barra lateral. Se conservan archivos y conversaciones y pueden restaurarse aquí. Se protegen los proyectos abiertos, fijados, en ejecución, con borradores o asuntos pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets archivés sont masqués dans la barre latérale. Leurs fichiers et conversations sont conservés et peuvent être restaurés ici. Les projets ouverts, épinglés, en cours ou avec un brouillon ou une action en attente sont protégés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブしたプロジェクトはサイドバーから非表示になります。ファイルと会話は保持され、ここで復元できます。開いている、固定済み、実行中、下書きや対応待ちのあるプロジェクトは保護されます。"
          }
        }
      }
    },
    "run-now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check inactive projects now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即检查未活跃项目"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar proyectos inactivos ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier les projets inactifs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用のプロジェクトを今すぐ確認"
          }
        }
      }
    },
    "archived": {
      "extractionState": "manual",
