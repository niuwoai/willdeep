    "save-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the project catalog, or it changed in another window. Project state was preserved. Restart the app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能保存项目列表，或项目已在其他窗口更新。项目状态已保留，请重新启动应用后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la lista o cambió en otra ventana. Se conservó el estado. Reinicia la aplicación e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder la liste, ou elle a changé dans une autre fenêtre. Son état a été conservé. Redémarrez puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト一覧を保存できなかったか、別のウィンドウで更新されました。状態は保持されています。アプリを再起動して再試行してください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
