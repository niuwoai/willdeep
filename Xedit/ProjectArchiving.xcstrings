            "state": "translated",
            "value": "Unarchive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复项目"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar proyecto"
          }
        },
        "fr": {
