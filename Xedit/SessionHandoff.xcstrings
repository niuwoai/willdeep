{
  "sourceLanguage" : "en",
  "strings" : {
    "session-handoff.already-running" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A handoff for this session is already in progress." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个会话已经在交接中了。" } } } },
    "session-handoff.command.placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "optional instructions for the receiving side" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "给接手一方的补充说明（可选）" } } } },
    "session-handoff.command.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hand this session off to willdeep-cli on another machine via a git branch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通过 git 分支把这个会话交给另一台机器上的 willdeep-cli 接着做" } } } },
    "session-handoff.failed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Handoff failed. %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "交接失败。%@" } } } },
    "session-handoff.git-failed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Handoff failed at git %@: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "交接在 git %@ 这一步失败：%@" } } } },
    "session-handoff.no-commits" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The repository has no commits yet. Make a first commit, then hand off." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仓库还没有任何提交。先做一次提交再交接。" } } } },
    "session-handoff.no-remote" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The repository has no git remote. Add one that the receiving machine can also reach." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仓库没有配置 git 远端。请添加一个接手的机器也能访问的远端。" } } } },
    "session-handoff.no-workspace" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Handoff needs a workspace folder. Open a folder for this session first." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "交接需要工作区文件夹。请先给这个会话打开一个文件夹。" } } } },
    "session-handoff.not-a-repository" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The workspace is not a git repository. Handoff carries the code through a git branch." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "工作区不是 git 仓库。交接要靠 git 分支传代码。" } } } },
    "session-handoff.push-failed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not push the handoff branch. Check that this Mac has git credentials for the remote (for example `gh auth login`). Details: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "交接分支推送失败。请确认这台 Mac 有该远端的 git 凭据（比如先 `gh auth login`）。详情：%@" } } } },
    "session-handoff.remote-workspace" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Handoff needs a local workspace folder. This session runs in a remote workspace." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "交接需要本机工作区文件夹，这个会话用的是远程工作区。" } } } },
    "session-handoff.sensitive-files" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Handoff stopped: these untracked files look like secrets and would be pushed: %@. Add them to .gitignore or remove them, then try again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "交接已停止：以下未跟踪文件像是密钥，会被一起推上去：%@。请把它们加进 .gitignore 或移走后再试。" } } } },
    "session-handoff.sessions-command.prompt" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "What are the other sessions in this workspace doing right now? List each one's current step and latest request, and point out any work that overlaps with this session." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个工作区里的其他会话现在各在做什么？列出每个会话的当前步骤和最近的请求，并指出和本会话重叠的工作。" } } } },
    "session-handoff.sessions-command.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "See what the other sessions in this workspace are doing" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "看看这个工作区里的其他会话在做什么" } } } },
    "session-handoff.started" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing the handoff: packaging this session and pushing a handoff branch…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备交接：打包本会话并推送交接分支…" } } } },
    "session-handoff.succeeded" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Handed off to branch `%1$@` on %2$@.%3$@ Nothing on this Mac changed: same branch, same working tree.\n\nOn the receiving machine, run this inside its clone of the repository (it needs git credentials for the remote and willdeep-cli installed). The command was also copied to the clipboard:\n\n```bash\n%4$@\n```" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已交接到 %2$@ 上的分支 `%1$@`。%3$@这台 Mac 上什么都没变：分支和工作区都保持原样。\n\n在接手的机器上，进入同一仓库的克隆目录执行下面的命令（那台机器需要有该远端的 git 凭据，并装好 willdeep-cli）。命令已复制到剪贴板：\n\n```bash\n%4$@\n```" } } } },
    "session-handoff.uncommitted-included" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : " Uncommitted changes are included." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未提交的改动也一并带上了。" } } } }
  },
  "version" : "1.0"
}
