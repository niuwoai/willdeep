{
  "sourceLanguage": "en",
  "strings": {
    "human-wait.parked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending confirmation or input — request retained"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待确认／待输入，原请求已保留"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認・入力待ち。元のリクエストは保持されています"
          }
        }
      }
    },
    "human-wait.independent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent task while waiting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待期间处理的独立任务"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中の独立タスク"
          }
        }
      }
    },
    "human-wait.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中"
          }
        }
      }
    },
    "human-wait.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task record"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务记录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク記録"
          }
        }
      }
    },
    "human-wait.blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependent or uncertain messages remain queued. No confirmation or answer has been inferred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有依赖或尚不明确的消息继续排队，系统不会代替你确认或回答。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存関係があるか不明なメッセージは待機します。確認や回答は代行しません。"
          }
        }
      }
    },
    "human-wait.run-independent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run as independent work (permissions unchanged)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为独立任务处理（权限不变）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立タスクとして処理（権限は変更しない）"
          }
        }
      }
    },
    "human-wait.stage-failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the independent task. The message remains queued."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立任务保存失败，消息仍保留在队列中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立タスクを保存できませんでした。メッセージはキューに保持されています。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
