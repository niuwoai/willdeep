    "settings.connectors.runtime-events.help" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Los eventos externos entran en una sesión dedicada del Orquestador de eventos. El token permanece en el Llavero, las cargas siempre se tratan como datos no fiables y los eventos externos no pueden interrumpir por la fuerza un paso activo del modelo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les événements externes arrivent dans une session dédiée de l’Orchestrateur d’événements. Le jeton reste dans le Trousseau, les charges sont toujours traitées comme des données non fiables et les événements externes ne peuvent pas interrompre de force une étape active du modèle." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "外部イベントは専用のイベントオーケストレーターセッションに入ります。トークンはキーチェーンに保存され、ペイロードは常に信頼できないデータとして扱われ、外部イベントが実行中のモデル処理を強制中断することはありません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "外部事件会进入专用的“事件调度中心”会话。Token 只存于钥匙串；载荷始终按不可信数据处理，外部事件不能强行打断正在执行的模型步骤。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "外部事件會進入專用的「事件調度中心」工作階段。Token 僅存於鑰匙圈；載荷一律視為不受信任資料，外部事件不能強制中斷正在執行的模型步驟。" } } } },
    "settings.connectors.runtime-events.counter-values" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Recibidos %lld · ACK %lld · Descartados %lld · Duplicados %lld · Pendientes en Relay %lld" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reçus %lld · ACK %lld · Rejetés %lld · Dédupliqués %lld · En attente dans le Relay %lld" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "受信 %lld · ACK 済み %lld · 破棄 %lld · 重複排除 %lld · Relay 保留 %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已接收 %lld · 已 ACK %lld · 已丢弃 %lld · 已去重 %lld · Relay 待处理 %lld" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已接收 %lld · 已 ACK %lld · 已丟棄 %lld · 已去重 %lld · Relay 待處理 %lld" } } } },
