{
  "sourceLanguage" : "en",
  "strings" : {
    "runtime-events.dismiss" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Descartar evento" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ignorer l’événement" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "イベントを無視" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "忽略事件" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "忽略事件" } } } },
