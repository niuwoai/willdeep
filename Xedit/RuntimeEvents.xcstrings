    "runtime-events.empty" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay eventos de Runtime en esta sesión" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun événement Runtime dans cette session" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このセッションに Runtime イベントはありません" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前会话暂无 Runtime 事件" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前工作階段沒有 Runtime 事件" } } } },
    "runtime-events.handled-in-conversation" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Gestionar esta solicitud en la conversación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Traiter cette demande dans la conversation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリクエストを会話で処理" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在会话中处理这个请求" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請在對話中處理此請求" } } } },
    "runtime-events.journal-save-failed" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo guardar el registro de eventos de Runtime. Los eventos entrantes podrían repetirse al reiniciar; comprueba el espacio libre y los permisos de la carpeta." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Échec de l’enregistrement du journal des événements Runtime. Des événements entrants peuvent être rejoués après le redémarrage ; vérifiez l’espace disque et les autorisations du dossier." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Runtime イベントジャーナルを保存できませんでした。再起動後に受信イベントが再配信される可能性があります。空き容量とフォルダ権限を確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Runtime 事件日志保存失败。重新启动后，外部事件可能被重复投递；请检查磁盘空间和目录权限。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Runtime 事件日誌儲存失敗。重新啟動後，外部事件可能被重複傳送；請檢查磁碟空間和資料夾權限。" } } } },
    "runtime-events.needs-action" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Requiere acción" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Action requise" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "対応が必要" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要处理" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要處理" } } } },
