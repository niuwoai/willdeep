    "runtime-events.source.worker" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Worker" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Worker" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Worker" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Worker" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Worker" } } } },
