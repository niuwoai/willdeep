    "session-schedules.inherit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue the source conversation using its workspace, model and permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续原会话，沿用工作区、模型和审批设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の会話の作業領域・モデル・権限を使用して続行します。"
          }
        }
      }
    }
