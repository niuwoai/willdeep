        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断"
          }
        }
      }
    },
    "session-schedules.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
