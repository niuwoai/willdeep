{
  "sourceLanguage": "en",
  "strings": {
    "session-schedules.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation schedules"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话定时任务"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の定期タスク"
          }
        }
      }
    },
    "session-schedules.enabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効"
          }
        }
      }
    },
    "session-schedules.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止"
          }
        }
      }
    },
    "session-schedules.pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause schedule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停计划"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を一時停止"
          }
        }
      }
    },
    "session-schedules.resume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume schedule"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复计划"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を再開"
          }
        }
      }
    },
    "session-schedules.source-busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source conversation is busy or archived; this run was skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原会话正在执行或已归档，本次已跳过。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の会話が使用中またはアーカイブ済みのためスキップしました。"
          }
        }
      }
    },
    "session-schedules.source-missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source conversation no longer exists; this run was skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原会话已不存在，本次已跳过。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の会話が存在しないためスキップしました。"
          }
        }
      }
    },
    "session-schedules.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中"
          }
        }
      }
    },
    "session-schedules.completed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Execution completed · unverified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行完成 · 未验证"
          }
