        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行完了・未検証"
          }
        }
      }
    },
    "session-schedules.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed"
