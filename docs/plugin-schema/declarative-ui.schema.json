{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://willdeep.com/schemas/plugin/v1/declarative-ui.json",
  "title": "WillDeep Declarative UI",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/component" } }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" },
        "kind": { "enum": ["section", "list", "row", "label", "icon", "badge", "status", "progress", "button", "disclosure", "separator", "emptyState", "loadingState", "errorState"] },
        "titleKey": { "type": "string", "pattern": "^\\S+$" },
        "subtitleKey": { "type": "string", "pattern": "^\\S+$" },
        "systemImage": { "type": "string" },
        "value": { "type": "string" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "command": { "type": "string" },
        "contextCommands": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "arguments": { "type": "object", "additionalProperties": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/component" } }
      }
    }
  }
}
